// EDL v3.0 Showcase: AI-Native Coordinate-Free Sensor Node (ATmega328P + AMS1117-3.3 + BMP280)
// Demonstrates high-density circuit idioms (`decouple`, `pullup`, `divider`, `series`, `rc_filter`)
// AND pin-anchored relative placement (`left_of`, `right_of`, `below`, `offset`, `at_angle`, `align_y`, `array`, `note`).
// ZERO raw global (x, y) coordinates anywhere in this file!

project "SensorNode_v3" {
    units: mm
    frame Sheet: Frame2

    circuit SensorNode {
        // 1. Power Input + 3.3V LDO Regulator
        component J1: "Connector_Generic:Conn_01x04" {
            value: "PWR_UART"
            footprint: "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical"
            orient: 180
        }
        component U1: "Regulator_Linear:AMS1117-3.3" {
            value: "AMS1117-3.3"
            pin VO: power_out(3.3V)
        }
        // 2. MCU Core (ATmega328P) + I2C Barometer (BMP280)
        component U2: "MCU_Microchip_ATmega:ATmega328P-A" {
            value: "ATmega328P-AU"
            no_connect: [PB0, PB1, PB2, PB3, PB4, PB5, "XTAL1/PB6", "XTAL2/PB7", PC0, PC1, PC2, PC3, PD2, PD3, PD4, PD5, PD6, PD7, ADC7, AREF]
        }
        component U3: "Sensor_Pressure:BMP280" {
            value: "BMP280"
            no_connect: [SDO]
        }
        component D1: "Device:LED" {
            value: "GREEN"
            footprint: "LED_SMD:LED_0603_1608Metric"
            orient: 270
        }

        // Core rails & signals
        net V5V  { power_flag: true  connect: [J1.Pin_1, U1.VI] }
        net V3V3 { connect: [U1.VO, U2.VCC, U3.VDD, U3.VDDIO, U3.CSB] }
        net GND  { power_flag: true  connect: [J1.Pin_4, U1.GND, U2.GND, U3.GND, D1.K] }
        net I2C_SDA { connect: [U2.PC4, U3.SDI] }
        net I2C_SCL { connect: [U2.PC5, U3.SCK] }

        // High-density v3.0 EE idioms (1 line = auto-oriented components + nets + pin-anchored layout!)
        decouple U1.VI   with [C1: "10uF", C2: "100nF"] to GND
        decouple U1.VO   with [C3: "22uF", C4: "100nF"] to GND
        decouple U2.VCC  with [C5: "100nF", C6: "100nF"] to GND
        decouple U3.VDD  with C7: "100nF" to GND

        pullup U2."RESET/PC6" with R1: "10k"  to V3V3
        pullup U2.PC4         with R2: "4.7k" to V3V3
        pullup U2.PC5         with R3: "4.7k" to V3V3

        divider V5V -> R4: "10k" -> VBUS_SNS at: U2.ADC6 -> R5: "10k" -> GND
        rc_filter V3V3 -> R6: "100" -> AVCC_FILT at: U2.AVCC -> C8: "100nF" -> GND
        series J1.Pin_2 -> R7: "220" -> U2.PD0
        series J1.Pin_3 -> R8: "220" -> U2.PD1
        series V3V3 -> R9: "1k" -> D1.A
    }

    schematic Main {
        sheet: A2 landscape
        title: "SensorNode v3.0 — Pure AI-Native Intent"
        rev: "3.0"
        routing {
            default: zone_local
            power_nets: symbol
            ground_nets: symbol
        }

        group Power {
            title: "5V Input & 3.3V LDO"
            hstack { J1, U1, D1 }
        }
        group Mcu {
            title: "ATmega328P Core"
            hstack { U2 }
        }
        group Sensor {
            title: "BMP280 I2C Pressure Sensor"
            hstack { U3 }
        }

        // Nuanced relative placements (zero global coordinates!)
        place R9 left_of D1.A gap: 5.08mm
        align_y J1.Pin_1 == U1.VI

        note "All passives auto-generated & pin-anchored by EDL v3.0 idioms (zero raw coordinates)." near: Power
        note "I2C pull-ups (4.7k) & analog AVCC RC filter verified by E1-E10 + KiCad 9 ERC." near: Mcu

        layout {
            arrange: [Power, Mcu, Sensor] left_to_right
        }
    }

    verify {
        require all_required_pins_connected
        require no_power_ground_short
        require no_multiple_power_drivers
        require voltage_compatibility
        require no_single_pin_nets
        require ic_decoupling
        require i2c_pullups
        require bom_manufacturability
    }
}
