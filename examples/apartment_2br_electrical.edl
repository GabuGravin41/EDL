// EDL v0.7.0 Multi-Domain Flagship: Architectural Floor Plan + Building Electrical Installation (IEC 60364)
// Both domains share ONE coordinate frame, ONE Canonical IR, ONE SVG & multi-layer AutoCAD DXF!
import "./lib/arch_units.edl"

project "Apartment_2BR_With_Electrical" {
  units: mm
  frame Plan: Frame2

  architecture.defaults {
    measurement_basis: clear_interior
    exterior_wall: 200mm
    interior_wall: 120mm
  }

  // --- Layer 1: Architectural Floor Plan ---
  use Bath1 = StandardBath(w: 2200mm, d: 2400mm)
  use Bed1  = StandardBedroom(w: 3600mm, d: 3400mm, bed_w: 1600mm, win_w: 1600mm)
  use Bed2  = StandardBedroom(w: 3200mm, d: 3400mm, bed_w: 1200mm, win_w: 1400mm)

  room Living {
    role: habitable
    clear_size: (4600mm, 4200mm)
    anchor: southwest at Plan.origin
  }

  room Hall {
    role: circulation
  }

  layout Plan {
    require Bath1.west == Living.east + interior_wall
    require Bath1.south == Living.south
    require Hall.west == Bath1.west
    require Hall.east == Bath1.east
    require Hall.south == Bath1.north + interior_wall
    require Hall.north == Living.north
    require Bed1.west == Living.west
    require Bed1.south == Living.north + interior_wall
    require Bed2.west == Bed1.east + interior_wall
    require Bed2.south == Bed1.south
  }

  opening EntryDoor: door {
    host: exterior(Living, south)
    width: 900mm
    offset: 300mm from start
    hinge: start
    swing: into Living
  }
  opening LivingToHall: passage {
    host: shared_wall(Living, Hall)
    width: 1200mm
    align: center
  }
  opening BathDoor: door {
    host: shared_wall(Hall, Bath1)
    width: 800mm
    offset: 200mm from end
    hinge: end
    swing: into Bath1
  }
  opening Bed1Door: door {
    host: shared_wall(Living, Bed1)
    width: 800mm
    offset: 300mm from end
    hinge: end
    swing: into Bed1
  }
  opening Bed2Door: door {
    host: shared_wall(Hall, Bed2)
    width: 800mm
    align: center
    hinge: start
    swing: into Bed2
  }
  opening LivingWinS: window {
    host: exterior(Living, south)
    width: 2000mm
    offset: 400mm from end
  }
  opening LivingWinW: window {
    host: exterior(Living, west)
    width: 1600mm
    align: center
  }

  fixture Sofa: sofa {
    room: Living
    size: (2200mm, 900mm)
    against: west
    offset: 200mm from end
    clearance_front: 700mm
  }
  fixture DiningTable: table {
    room: Living
    size: (1200mm, 800mm)
    at: (2600mm, 1400mm)
    clearance_all: 500mm
  }

  // --- Layer 2: Building Electrical Installation (anchored directly onto rooms, walls & doors!) ---
  building_electrical MainInstall {
    supply: 230V 50Hz
    ceiling_height: 2700mm

    // Main Distribution Board on Hall east wall
    panel DB1 {
      host: wall(Hall, east)
      align: center
      main_breaker: 63A
      height: 1500mm
    }

    // Breaker Circuits (IEC 60364: 10A/1.5mm2 lighting, 20A/2.5mm2 RCD sockets, 16A/2.5mm2 RCD wet)
    breaker C1_Lights: lighting {
      from: DB1
      rating: 10A
      cable: 1.5mm2
      rcd: 30mA
      max_voltage_drop: 3%
    }

    breaker C2_LivingSockets: socket {
      from: DB1
      rating: 20A
      cable: 2.5mm2
      rcd: 30mA
      max_voltage_drop: 5%
    }

    breaker C3_BedSockets: socket {
      from: DB1
      rating: 20A
      cable: 2.5mm2
      rcd: 30mA
      max_voltage_drop: 5%
    }

    breaker C4_BathAux: appliance {
      from: DB1
      rating: 16A
      cable: 2.5mm2
      rcd: 30mA
      max_voltage_drop: 5%
    }

    // Ceiling Luminaires in every room
    light L_Living: ceiling { room: Living at: center load: 36W circuit: C1_Lights }
    light L_Hall:   ceiling { room: Hall   at: center load: 18W circuit: C1_Lights }
    light L_Bath:   ceiling { room: Bath1  at: center load: 18W circuit: C1_Lights ip: IP44 }
    light L_Bed1:   ceiling { room: Bed1   at: center load: 24W circuit: C1_Lights }
    light L_Bed2:   ceiling { room: Bed2   at: center load: 24W circuit: C1_Lights }

    // Switches — semantically anchored to door latch sides (never behind door swings!)
    switch SW_Entry: 2gang {
      host: beside(EntryDoor, latch_side, 180mm)
      room: Living
      controls: [L_Living, L_Hall]
      circuit: C1_Lights
    }
    // Bathroom light switch mounted safely OUTSIDE Bath1 in Hall beside BathDoor!
    switch SW_Bath: 1gang {
      host: beside(BathDoor, latch_side, 180mm)
      room: Hall
      controls: [L_Bath]
      circuit: C1_Lights
    }
    switch SW_Bed1: 1gang {
      host: beside(Bed1Door, latch_side, 180mm)
      room: Bed1
      controls: [L_Bed1]
      circuit: C1_Lights
    }
    switch SW_Bed2: 1gang {
      host: beside(Bed2Door, latch_side, 180mm)
      room: Bed2
      controls: [L_Bed2]
      circuit: C1_Lights
    }

    // Wall Outlets / Sockets hosted directly on room walls
    outlet S_Liv_N: duplex { host: wall(Living, north) offset: 700mm from start height: 300mm load: 600W circuit: C2_LivingSockets }
    outlet S_Liv_E: duplex { host: wall(Living, east)  offset: 900mm from start height: 300mm load: 600W circuit: C2_LivingSockets }
    outlet S_Liv_S: duplex { host: wall(Living, south) offset: 1600mm from end  height: 300mm load: 600W circuit: C2_LivingSockets }

    outlet S_Bed1_W: duplex { host: wall(Bed1, west) offset: 500mm from start height: 300mm load: 500W circuit: C3_BedSockets }
    outlet S_Bed1_S: duplex { host: wall(Bed1, south) offset: 800mm from start height: 300mm load: 500W circuit: C3_BedSockets }
    outlet S_Bed2_E: duplex { host: wall(Bed2, east) offset: 500mm from start height: 300mm load: 500W circuit: C3_BedSockets }
    outlet S_Bed2_S: duplex { host: wall(Bed2, south) offset: 500mm from end   height: 300mm load: 500W circuit: C3_BedSockets }

    // Bathroom shaver/vanity socket on east wall away from Shower (>= 600mm IEC Zone 2 clear!)
    outlet S_Bath_Shaver: shaver {
      host: wall(Bath1, east)
      offset: 500mm from start
      height: 1200mm
      load: 1500W
      circuit: C4_BathAux
      ip: IP44
    }
  }

  verify {
    // 6 Architectural Rules
    require no_room_overlap
    require opening_jamb_margin >= 100mm
    require no_door_swing_collision
    require all_rooms_reachable
    require no_fixture_collision
    require habitable_rooms_have_window
    // 6 Building Electrical Rules (IEC 60364)
    require breaker_load_ok
    require voltage_drop_ok
    require wet_zone_clearance
    require switch_accessible
    require electrical_device_clear
    require wet_circuits_rcd_protected
  }

  view PlanView: plan {
    frame: Plan
    sheet: A3 landscape
    scale: 1:50
    show_dimensions: true
    show_labels: true
  }
}
