// Benchmark 1: 24V Industrial IoT Edge Gateway & Isolated Relay Controller
// Designed in EDL v3.2 — 5 functional stages, 4 voltage domains (24V, 5V, 3.3V, ISO_24V)
// Pure intent-based topology + structured zone layout (zero raw global coordinates!)

project "Industrial_IoT_Edge_Gateway_24V" {
    units: mm
    frame Sheet: Frame2

    circuit Gateway {
        // =========================================================================
        // STAGE 1: 24V Industrial Power Input, Surge Protection & 24V->5V Buck
        // =========================================================================
        component J_PWR: "Connector:Screw_Terminal_01x02" {
            value: "24V_IN"
            footprint: "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-1,5-2-5.08_1x02_P5.08mm_Horizontal"
            orient: 180
        }
        component F1: "Device:Polyfuse" {
            value: "1.5A_PTC"
            footprint: "Fuse:Fuse_1812_4532Metric"
            orient: 90
        }
        component D_TVS: "Device:D_TVS" {
            value: "SMBJ28A"
            footprint: "Diode_SMD:D_SMB"
            orient: 90
        }
        component D_REV: "Device:D_Schottky" {
            value: "SS34"
            footprint: "Diode_SMD:D_SMA"
            orient: 180
        }
        component C_EMI1: "Device:C_Polarized" {
            value: "100uF"
            voltage_rating: 50V
            footprint: "Capacitor_SMD:CP_Elec_8x10.5"
        }
        component L_EMI: "Device:L" {
            value: "10uH"
            footprint: "Inductor_SMD:L_1210_3225Metric"
            orient: 90
        }
        component C_IN1: "Device:C_Polarized" {
            value: "220uF"
            voltage_rating: 50V
            footprint: "Capacitor_SMD:CP_Elec_10x10.5"
        }
        component C_IN2: "Device:C" {
            value: "100nF"
            voltage_rating: 50V
            footprint: "Capacitor_SMD:C_0805_2012Metric"
        }
        component U_BUCK: "Regulator_Switching:LM2596S-ADJ" {
            value: "LM2596S-ADJ"
            footprint: "Package_TO_SOT_SMD:TO-263-5_TabPin3"
        }
        component D_BUCK: "Device:D_Schottky" {
            value: "SS34"
            footprint: "Diode_SMD:D_SMA"
            orient: 90
        }
        component L_BUCK: "Device:L" {
            value: "33uH"
            footprint: "Inductor_SMD:L_Bourns_SRR1260"
            orient: 90
        }
        component R_FB1: "Device:R" {
            value: "3.09k"
            power_rating: 250mW
            footprint: "Resistor_SMD:R_0805_2012Metric"
        }
        component R_FB2: "Device:R" {
            value: "1k"
            power_rating: 250mW
            footprint: "Resistor_SMD:R_0805_2012Metric"
        }
        component C_OUT1: "Device:C_Polarized" {
            value: "220uF"
            voltage_rating: 25V
            footprint: "Capacitor_SMD:CP_Elec_8x10.5"
        }
        component C_OUT2: "Device:C" {
            value: "100nF"
            voltage_rating: 25V
            footprint: "Capacitor_SMD:C_0805_2012Metric"
        }

        // =========================================================================
        // STAGE 2: 5V->3.3V Low-Noise LDO & Power Indicator
        // =========================================================================
        component U_LDO: "Regulator_Linear:AMS1117-3.3" {
            value: "AMS1117-3.3"
            footprint: "Package_TO_SOT_SMD:SOT-223-3_TabPin2"
            pin VO: power_out(3.3V)
        }
        component C_LDO_IN: "Device:C" {
            value: "10uF"
            voltage_rating: 16V
            footprint: "Capacitor_SMD:C_0805_2012Metric"
        }
        component C_LDO_OUT: "Device:C" {
            value: "22uF"
            voltage_rating: 16V
            footprint: "Capacitor_SMD:C_0805_2012Metric"
        }
        component R_PWR: "Device:R" {
            value: "330"
            power_rating: 250mW
            footprint: "Resistor_SMD:R_0805_2012Metric"
        }
        component D_PWR: "Device:LED" {
            value: "GREEN"
            footprint: "LED_SMD:LED_0805_2012Metric"
            orient: 270
        }

        // =========================================================================
        // STAGE 3: MCU Core (STM32F103C8T6), 8MHz Clock, Reset & SWD/UART Debug
        // =========================================================================
        component U_MCU: "MCU_ST_STM32F1:STM32F103C8Tx" {
            value: "STM32F103C8T6"
            footprint: "Package_QFP:LQFP-48_7x7mm_P0.5mm"
            pin VSSA: ground
            no_connect: [
                PC13, PC14, PC15,
                PA4, PA5, PA6, PA7, PA8, PA11, PA12, PA15,
                PB1, PB2, PB3, PB4, PB5, PB8, PB9, PB10, PB11, PB12, PB13, PB14, PB15
            ]
        }
        component C_MCU1: "Device:C" {
            value: "10uF"
            voltage_rating: 16V
            footprint: "Capacitor_SMD:C_0805_2012Metric"
        }
        component C_MCU2: "Device:C" {
            value: "100nF"
            voltage_rating: 16V
            footprint: "Capacitor_SMD:C_0603_1608Metric"
        }
        component C_MCU3: "Device:C" {
            value: "100nF"
            voltage_rating: 16V
            footprint: "Capacitor_SMD:C_0603_1608Metric"
        }
        component C_MCU4: "Device:C" {
            value: "100nF"
            voltage_rating: 16V
            footprint: "Capacitor_SMD:C_0603_1608Metric"
        }
        component Y1: "Device:Crystal" {
            value: "8MHz"
            footprint: "Crystal:Crystal_SMD_3225-4Pin_3.2x2.5mm"
        }
        component C_XTAL1: "Device:C" {
            value: "20pF"
            voltage_rating: 50V
            footprint: "Capacitor_SMD:C_0603_1608Metric"
        }
        component C_XTAL2: "Device:C" {
            value: "20pF"
            voltage_rating: 50V
            footprint: "Capacitor_SMD:C_0603_1608Metric"
        }
        component R_RST: "Device:R" {
            value: "10k"
            power_rating: 125mW
            footprint: "Resistor_SMD:R_0603_1608Metric"
        }
        component C_RST: "Device:C" {
            value: "100nF"
            voltage_rating: 16V
            footprint: "Capacitor_SMD:C_0603_1608Metric"
        }
        component SW_RST: "Switch:SW_Push" {
            value: "RESET"
            footprint: "Button_Switch_SMD:SW_SPST_CK_RS282G05A3"
        }
        component R_BOOT0: "Device:R" {
            value: "10k"
            power_rating: 125mW
            footprint: "Resistor_SMD:R_0603_1608Metric"
        }
        component J_SWD: "Connector_Generic:Conn_01x05" {
            value: "SWD_DEBUG"
            footprint: "Connector_PinHeader_2.54mm:PinHeader_1x05_P2.54mm_Vertical"
        }
        component J_UART: "Connector_Generic:Conn_01x03" {
            value: "UART_CONSOLE"
            footprint: "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical"
        }

        // =========================================================================
        // STAGE 4: Shared I2C Bus, RS-485 Transceiver & 0-10V Analog Front-End
        // =========================================================================
        component U_SENS: "Sensor_Humidity:SHT30-DIS" {
            value: "SHT30-DIS"
            footprint: "Sensor_Humidity:Sensirion_DFN-8-1EP_2.5x2.5mm_P0.5mm_EP1.1x1.7mm"
            no_connect: [ALERT]
        }
        component R_SENS_RST: "Device:R" {
            value: "10k"
            power_rating: 125mW
            footprint: "Resistor_SMD:R_0603_1608Metric"
        }
        component C_SENS: "Device:C" {
            value: "100nF"
            voltage_rating: 16V
            footprint: "Capacitor_SMD:C_0603_1608Metric"
        }
        component U_EEPROM: "Memory_EEPROM:24LC256" {
            value: "24LC256"
            footprint: "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm"
        }
        component C_EEPROM: "Device:C" {
            value: "100nF"
            voltage_rating: 16V
            footprint: "Capacitor_SMD:C_0603_1608Metric"
        }
        component R_SDA: "Device:R" {
            value: "4.7k"
            power_rating: 125mW
            footprint: "Resistor_SMD:R_0603_1608Metric"
        }
        component R_SCL: "Device:R" {
            value: "4.7k"
            power_rating: 125mW
            footprint: "Resistor_SMD:R_0603_1608Metric"
        }

        component U_485: "Interface_UART:SP3485EN" {
            value: "SP3485EN"
            footprint: "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm"
        }
        component C_485: "Device:C" {
            value: "100nF"
            voltage_rating: 16V
            footprint: "Capacitor_SMD:C_0603_1608Metric"
        }
        component R_TERM: "Device:R" {
            value: "120"
            power_rating: 250mW
            footprint: "Resistor_SMD:R_0805_2012Metric"
        }
        component J_RS485: "Connector:Screw_Terminal_01x03" {
            value: "RS485_BUS"
            footprint: "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-1,5-3-5.08_1x03_P5.08mm_Horizontal"
        }

        component J_AIN: "Connector:Screw_Terminal_01x02" {
            value: "AIN_0_10V"
            footprint: "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-1,5-2-5.08_1x02_P5.08mm_Horizontal"
            orient: 180
        }
        component R_AIN1: "Device:R" {
            value: "23.2k"
            power_rating: 250mW
            footprint: "Resistor_SMD:R_0805_2012Metric"
            orient: 90
        }
        component R_AIN2: "Device:R" {
            value: "10k"
            power_rating: 250mW
            footprint: "Resistor_SMD:R_0805_2012Metric"
        }
        component R_AAF: "Device:R" {
            value: "1k"
            power_rating: 125mW
            footprint: "Resistor_SMD:R_0603_1608Metric"
            orient: 90
        }
        component C_AAF: "Device:C" {
            value: "100nF"
            voltage_rating: 16V
            footprint: "Capacitor_SMD:C_0603_1608Metric"
        }
        component D_CLAMP: "Diode:BAT54S" {
            value: "BAT54S"
            footprint: "Package_TO_SOT_SMD:SOT-23"
        }

        // =========================================================================
        // STAGE 5: Galvanically Isolated 24V Relay / Solenoid Driver Output
        // =========================================================================
        component R_OPTO: "Device:R" {
            value: "330"
            power_rating: 250mW
            footprint: "Resistor_SMD:R_0805_2012Metric"
            orient: 90
        }
        component U_OPTO: "Isolator:PC817" {
            value: "PC817"
            footprint: "Package_DIP:DIP-4_W7.62mm"
            isolated: true
        }
        component R_GATE: "Device:R" {
            value: "10k"
            power_rating: 250mW
            footprint: "Resistor_SMD:R_0805_2012Metric"
            orient: 90
        }
        component R_PD: "Device:R" {
            value: "10k"
            power_rating: 250mW
            footprint: "Resistor_SMD:R_0805_2012Metric"
        }
        component Q_RLY: "Transistor_FET:2N7002" {
            value: "2N7002"
            footprint: "Package_TO_SOT_SMD:SOT-23"
        }
        component K1: "Relay:Relay_SPDT" {
            value: "24V_SPDT_RELAY"
            footprint: "Relay_THT:Relay_SPDT_SANYOU_SRD_Series_Form_C"
        }
        component D_FLY: "Device:D" {
            value: "1N4007"
            footprint: "Diode_SMD:D_SMA"
            orient: 90
        }
        component C_ISO: "Device:C_Polarized" {
            value: "100uF"
            voltage_rating: 50V
            footprint: "Capacitor_SMD:CP_Elec_8x10.5"
        }
        component J_ISO_PWR: "Connector:Screw_Terminal_01x02" {
            value: "ISO_24V"
            footprint: "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-1,5-2-5.08_1x02_P5.08mm_Horizontal"
            orient: 180
        }
        component J_OUT: "Connector:Screw_Terminal_01x03" {
            value: "RELAY_OUT"
            footprint: "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-1,5-3-5.08_1x03_P5.08mm_Horizontal"
        }

        // =========================================================================
        // NETS — 4 VOLTAGE DOMAINS: 24V, 5V, 3.3V, AND ISOLATED 24V
        // =========================================================================

        // --- Stage 1: 24V Input, Surge Protection, Pi EMI Filter & Buck ---
        net IN24_RAW   { connect: [J_PWR.Pin_1, F1.1] }
        net IN24_FUSED { connect: [F1.2, D_TVS.A1, D_REV.A] }
        net IN24_PROT  { connect: [D_REV.K, C_EMI1.1, L_EMI.1] }
        net V24_FILT   { power_flag: true  connect: [L_EMI.2, C_IN1.1, C_IN2.1, U_BUCK.VIN] }
        net BUCK_SW    { connect: [U_BUCK.OUT, D_BUCK.K, L_BUCK.1] }
        net BUCK_FB    { connect: [U_BUCK.FB, R_FB1.2, R_FB2.1] }

        // --- Stage 1 -> Stage 2: 5V Rail ---
        net V5V {
            power_flag: true
            connect: [L_BUCK.2, R_FB1.1, C_OUT1.1, C_OUT2.1, U_LDO.VI, C_LDO_IN.1]
        }

        // --- Stage 2 -> Stages 3 & 4: 3.3V Rail (driven by U_LDO.VO power_out) ---
        net V3V3 {
            connect: [
                U_LDO.VO, C_LDO_OUT.1, R_PWR.1,
                U_MCU.VDD, U_MCU.VDDA, U_MCU.VBAT,
                C_MCU1.1, C_MCU2.1, C_MCU3.1, C_MCU4.1,
                R_RST.1, J_SWD.Pin_1,
                U_SENS.VDD, R_SENS_RST.1, C_SENS.1,
                U_EEPROM.VCC, C_EEPROM.1,
                R_SDA.1, R_SCL.1,
                U_485.VCC, C_485.1,
                D_CLAMP.K
            ]
        }
        net SENS_NRST { connect: [R_SENS_RST.2, U_SENS.RESET] }
        net PWR_LED_A { connect: [R_PWR.2, D_PWR.A] }

        // --- Primary Logic Ground (Stages 1–4 + Opto Primary LED Cathode) ---
        net GND {
            power_flag: true
            connect: [
                J_PWR.Pin_2, D_TVS.A2, C_EMI1.2, C_IN1.2, C_IN2.2,
                U_BUCK.GND, U_BUCK."ON/OFF", D_BUCK.A, R_FB2.2, C_OUT1.2, C_OUT2.2,
                U_LDO.GND, C_LDO_IN.2, C_LDO_OUT.2, D_PWR.K,
                U_MCU.VSS, U_MCU.VSSA, C_MCU1.2, C_MCU2.2, C_MCU3.2, C_MCU4.2,
                C_XTAL1.2, C_XTAL2.2, C_RST.2, SW_RST.2, R_BOOT0.2,
                J_SWD.Pin_5, J_UART.Pin_3,
                U_SENS.VSS, U_SENS.ADDR, U_SENS.R, C_SENS.2,
                U_EEPROM.GND, U_EEPROM.A0, U_EEPROM.A1, U_EEPROM.A2, U_EEPROM.WP, C_EEPROM.2,
                U_485.GND, C_485.2, J_RS485.Pin_3,
                J_AIN.Pin_2, R_AIN2.2, C_AAF.2, D_CLAMP.A,
                U_OPTO.2
            ]
        }

        // --- Stage 3: MCU Clock, Reset, Boot, SWD & UART ---
        net XTAL_IN   { connect: [U_MCU.PD0, Y1.1, C_XTAL1.1] }
        net XTAL_OUT  { connect: [U_MCU.PD1, Y1.2, C_XTAL2.1] }
        net MCU_NRST  { connect: [U_MCU.NRST, R_RST.2, C_RST.1, SW_RST.1, J_SWD.Pin_4] }
        net MCU_BOOT0 { connect: [U_MCU.BOOT0, R_BOOT0.1] }
        net SWDIO     { connect: [U_MCU.PA13, J_SWD.Pin_2] }
        net SWCLK     { connect: [U_MCU.PA14, J_SWD.Pin_3] }
        net UART_TX   { connect: [U_MCU.PA9, J_UART.Pin_1] }
        net UART_RX   { connect: [U_MCU.PA10, J_UART.Pin_2] }

        // --- Stage 4: Shared I2C Bus, RS-485 & 0-10V Analog Front-End ---
        net I2C_SDA   { connect: [U_MCU.PB7, U_SENS.SDA, U_EEPROM.SDA, R_SDA.2] }
        net I2C_SCL   { connect: [U_MCU.PB6, U_SENS.SCL, U_EEPROM.SCL, R_SCL.2] }

        net RS485_TX  { connect: [U_MCU.PA2, U_485.DI] }
        net RS485_RX  { connect: [U_MCU.PA3, U_485.RO] }
        net RS485_DE  { connect: [U_MCU.PA1, U_485.DE, U_485.RE] }
        net RS485_A   { connect: [U_485.A, R_TERM.1, J_RS485.Pin_1] }
        net RS485_B   { connect: [U_485.B, R_TERM.2, J_RS485.Pin_2] }

        net AIN_10V   { connect: [J_AIN.Pin_1, R_AIN1.1] }
        net AIN_DIV   { connect: [R_AIN1.2, R_AIN2.1, R_AAF.1] }
        net ADC_AIN   { connect: [R_AAF.2, C_AAF.1, D_CLAMP.COM, U_MCU.PA0] }

        // --- Stage 5: Galvanically Isolated 24V Relay Driver ---
        net RLY_CTRL   { connect: [U_MCU.PB0, R_OPTO.1] }
        net OPTO_LED_A { connect: [R_OPTO.2, U_OPTO.1] }

        // Isolated secondary power domain (NO conductive path to GND or V24_FILT!)
        net ISO_24V    { connect: [J_ISO_PWR.Pin_1, C_ISO.1, U_OPTO.4, K1.A1, D_FLY.K] }
        net ISO_GND    { connect: [J_ISO_PWR.Pin_2, C_ISO.2, R_PD.2, Q_RLY.S] }
        net OPTO_EMIT  { connect: [U_OPTO.3, R_GATE.1] }
        net Q_RLY_G    { connect: [R_GATE.2, R_PD.1, Q_RLY.G] }
        net RLY_COIL_N { connect: [Q_RLY.D, K1.A2, D_FLY.A] }
        net RLY_COM    { connect: [K1.11, J_OUT.Pin_1] }
        net RLY_NO     { connect: [K1.14, J_OUT.Pin_2] }
        net RLY_NC     { connect: [K1.12, J_OUT.Pin_3] }
    }

    schematic Main {
        sheet: A1 landscape
        title: "24V Industrial IoT Edge Gateway & Isolated Relay Controller"
        rev: "1.0"

        routing {
            default: zone_local
            power_nets: symbol
            ground_nets: symbol
        }

        zone STAGE1_POWER {
            title: "STAGE 1: 24V INPUT, SURGE/EMI PROTECTION & 24V->5V BUCK (LM2596S-ADJ)"
            hstack {
                subzone "24V INPUT & SURGE/PI-EMI" {
                    hstack { J_PWR  F1  D_TVS  D_REV  C_EMI1  L_EMI  C_IN1  C_IN2 }
                }
                subzone "24V->5V BUCK REGULATOR" {
                    hstack { U_BUCK  D_BUCK  L_BUCK  R_FB1  R_FB2  C_OUT1  C_OUT2 }
                }
            }
            note "24V Input caps rated 50V (>=35V); Buck FB: Vout = 1.23*(1+3.09k/1k) = 5.03V; Output caps rated 25V (>=10V)"
        }

        zone STAGE2_LDO {
            title: "STAGE 2: 5V->3.3V LOW-NOISE LDO & PWR LED"
            hstack { C_LDO_IN  U_LDO  C_LDO_OUT  R_PWR  D_PWR }
            note "AMS1117-3.3; LED current ~3.9mA (R_PWR=330R, 250mW, <3% derating)"
        }

        zone STAGE3_MCU {
            title: "STAGE 3: STM32F103C8T6 MCU CORE, 8MHz CLOCK, RESET & DEBUG"
            hstack {
                subzone "RESET, BOOT & 8MHz CLOCK" {
                    vstack {
                        hstack { R_RST  C_RST  SW_RST }
                        hstack { Y1  C_XTAL1  C_XTAL2 }
                        hstack { R_BOOT0 }
                    }
                }
                subzone "MCU & DECOUPLING" {
                    vstack {
                        hstack { C_MCU1  C_MCU2  C_MCU3  C_MCU4 }
                        U_MCU
                    }
                }
                subzone "SWD & UART DEBUG" {
                    vstack { J_SWD  J_UART }
                }
            }
            note "8MHz HSE + 20pF load caps; 4x local VDD decoupling; 5-pin SWD + 3-pin UART"
        }

        zone STAGE4_PERIPHERALS {
            title: "STAGE 4: SHARED I2C BUS, RS-485 TRANSCEIVER & 0-10V ANALOG FRONT-END"
            vstack {
                subzone "SHARED I2C BUS (4.7k PULL-UPS)" {
                    hstack { R_SDA  R_SCL  R_SENS_RST  U_SENS  C_SENS  U_EEPROM  C_EEPROM }
                }
                subzone "RS-485 INDUSTRIAL TRANSCEIVER (120R TERM)" {
                    hstack { C_485  U_485  R_TERM  J_RS485 }
                }
                subzone "0-10V ANALOG FRONT-END (3.01V DIV + 1.59kHz AAF + BAT54S CLAMP)" {
                    hstack { J_AIN  R_AIN1  R_AIN2  R_AAF  C_AAF  D_CLAMP }
                }
            }
            note "I2C: SHT30 (0x44) + 24LC256 (0x50); RS-485: SP3485EN + 120R; AFE: 23.2k/10k + 1k/100nF (fc=1.59kHz)"
        }

        zone STAGE5_ISO_RELAY {
            title: "STAGE 5: GALVANICALLY ISOLATED 24V RELAY DRIVER (ISO_24V / ISO_GND)"
            hstack {
                subzone "OPTO ISOLATION BARRIER" {
                    hstack { R_OPTO  U_OPTO }
                }
                subzone "ISOLATED 24V RELAY DRIVER & FLYBACK" {
                    hstack { J_ISO_PWR  C_ISO  R_GATE  R_PD  Q_RLY  D_FLY  K1  J_OUT }
                }
            }
            note "PC817 galvanic barrier (GND != ISO_GND); 10k/10k Vgs=12V; 1N4007 antiparallel flyback across K1 coil"
        }

        layout {
            row [STAGE1_POWER, STAGE2_LDO]
            row [STAGE3_MCU, STAGE4_PERIPHERALS]
            row [STAGE5_ISO_RELAY]
            group_gap: 20.32mm
            row_gap: 22.86mm
        }
    }

    verify {
        require all_required_pins_connected
        require no_power_ground_short
        require no_multiple_power_drivers
        require voltage_compatibility
        require no_single_pin_nets
        require galvanic_isolation(GND, ISO_GND)
        require ic_decoupling
        require i2c_pullups
        require inductive_flyback
        require bom_manufacturability
    }
}
