		(date "2026-11-27")
		(rev "1.0")
		(company "Industrial Automation Engineering — PLC-4S Controller")
		(comment 1 "4-Sheet A2 Hierarchy | 3 Galvanic Isolation Domains")
		(comment 2 "STM32F407 + LAN8720A | Iso DI/Relays | Analog + RS485/CAN")
	)
	(lib_symbols
	)
	(text "INDUSTRIAL PLC & ETHERNET / FIELDBUS CONTROLLER — SYSTEM HIERARCHY" (exclude_from_sim no) (at 297 26 0)
		(effects (font (size 4.2 4.2) (bold yes) (color 20 50 110 1)))
		(uuid "4288e789-82e8-5f8f-ad21-a80f74d873ab")
	)
	(text "4-Sheet Hierarchical KiCad 9 Architecture  |  3 Galvanic Isolation Domains (Main GND, ISO_IO_GND, ISO_BUS_GND)" (exclude_from_sim no) (at 297 33.5 0)
		(effects (font (size 2.2 2.2) (color 80 90 100 1)))
		(uuid "c189d738-9f27-593c-adcd-d32b1820c7e4")
	)
	(text "Multi-Rail Industrial Power Architecture\n• 24V Input: Fuse, SS34, SMBJ28A TVS, Pi EMI\n• 24V -> 5V Buck (LM2596S-ADJ, 3A)\n• 5V -> +3V3 Digital & +3V3A Analog LDOs\n• 5V -> ISO_BUS_5V / ISO_BUS_GND (TMR-0511)\n• Dual Supervisors (MCP100) + LEDs + TPs" (exclude_from_sim no) (at 53.34 83.82 0)
		(effects (font (size 1.9 1.9) (color 40 55 80 1)) (justify left))
		(uuid "64ff6f61-97d9-5dac-a15e-18eb0412ddca")
	)
	(text "STM32F407VETx MCU & Ethernet Core\n• Cortex-M4F 168MHz (LQFP-100) + 8MHz HSE\n• Full Decoupling Bank (VDD + VDDA + VCAP)\n• LAN8720A RMII PHY + 25MHz + HR911105A RJ45\n• W25Q32 SPI Flash | LM75C Temp | PCF8563T RTC\n• 10-Pin SWD Header + Debug UART1 + Status LEDs" (exclude_from_sim no) (at 358.14 86.36 0)
		(effects (font (size 1.9 1.9) (color 30 75 65 1)) (justify left))
		(uuid "9aa3207a-1b19-51a2-9c49-43cd267748e0")
	)
	(text "Galvanically Isolated I/O (ISO_IO_GND Domain)\n• 2.5 kVrms Barrier — 0 Shared Refs w/ Main GND\n• 4-Ch 24V Digital Inputs (PC817, Balanced R, RC)\n• 4-Ch 24V SPDT Relays (PC817, 2N7002, G5LE-1)\n• Flyback Diodes (1N4148W) + Iso 24V Power Port" (exclude_from_sim no) (at 55.88 287.02 0)
		(effects (font (size 1.9 1.9) (color 140 45 25 1)) (justify left))
		(uuid "e7ff2235-3f38-5037-aa0c-57b41b278cdf")
	)
	(text "Analog Front-End & Isolated Fieldbus (ISO_BUS_GND)\n• 2-Ch 0-10V / 4-20mA Analog FE (BAT54S + LM358)\n• 2.5 kVrms Barrier — 0 Shared Refs w/ GND or IO_GND\n• Opto-Isolated RS-485 (LTC2850IS8, 120R, Bias, TVS)\n• Opto-Isolated CAN (MCP2551, 120R Split, TVS)" (exclude_from_sim no) (at 330.2 287.02 0)
		(effects (font (size 1.9 1.9) (color 90 40 120 1)) (justify left))
		(uuid "9000f6f9-9319-55a7-84ef-4bb586582829")
	)
	(rectangle (start 200.66 147.32) (end 312.42 195.58)
		(stroke (width 0.35) (type solid) (color 120 40 40 1))
		(fill (type color) (color 255 252 240 0.95))
		(uuid "6526d8af-0fc1-550d-b31f-48e0a80299b4")
	)
	(text "GLOBAL POWER & ISOLATION DOMAINS" (exclude_from_sim no) (at 203.66 152.32 0)
		(effects (font (size 2.54 2.54) (bold yes) (color 120 40 40 1)) (justify left top))
		(uuid "d9e3959d-3dbe-539b-a359-57a37cc47f28")
	)
	(text "Domain 1 (Main Logic / Analog):\n  +24V, +5V, +3V3, +3V3A, GND\nDomain 2 (Isolated Field I/O — Sheet 3):\n  ISO_IO_24V, ISO_IO_GND (External 24V)\nDomain 3 (Isolated Fieldbus — Sheet 1 & 4):\n  ISO_BUS_5V, ISO_BUS_GND (TMR-0511 + FB2/3)\nGalvanic Isolation: 0 shared component refs!" (exclude_from_sim no) (at 204.47 159 0)
		(effects (font (size 1.6 1.6) (color 60 30 30 1)) (justify left top))
		(uuid "8d8b4b54-5c7d-57e0-8417-e39b9b419323")
	)
