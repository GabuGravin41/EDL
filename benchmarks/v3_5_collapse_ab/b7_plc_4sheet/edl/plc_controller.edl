    net ETH_RST      { connect: [U_MCU.81, U_PHY.15, R_PHY_RST.2] }

    net RMII_TXEN    { connect: [U_MCU.48, R_RMII_TXEN.1] }
    net PHY_TXEN     { connect: [R_RMII_TXEN.2, U_PHY.16] }
    net RMII_TXD0    { connect: [U_MCU.51, R_RMII_TXD0.1] }
    net PHY_TXD0     { connect: [R_RMII_TXD0.2, U_PHY.17] }
    net RMII_TXD1    { connect: [U_MCU.52, R_RMII_TXD1.1] }
    net PHY_TXD1     { connect: [R_RMII_TXD1.2, U_PHY.18] }
    net RMII_RXD0    { connect: [U_MCU.33, R_RMII_RXD0.1] }
    net PHY_RXD0     { connect: [R_RMII_RXD0.2, U_PHY.8] }
    net RMII_RXD1    { connect: [U_MCU.34, R_RMII_RXD1.1] }
    net PHY_RXD1     { connect: [R_RMII_RXD1.2, U_PHY.7] }
    net RMII_CRSDV   { connect: [U_MCU.32, R_RMII_CRSDV.1] }
    net PHY_CRSDV    { connect: [R_RMII_CRSDV.2, U_PHY.11] }
    net RMII_REFCLK  { connect: [U_MCU.24, R_RMII_CLK.1] }
    net PHY_REFCLK   { connect: [R_RMII_CLK.2, U_PHY.14] }

    net ETH_TXP      { connect: [U_PHY.21, R_ETH_TXP.2, J_ETH.1] }
    net ETH_TXN      { connect: [U_PHY.20, R_ETH_TXN.2, J_ETH.3] }
    net ETH_RXP      { connect: [U_PHY.23, R_ETH_RXP.2, J_ETH.4] }
    net ETH_RXN      { connect: [U_PHY.22, R_ETH_RXN.2, J_ETH.6] }
    net ETH_LED1_A   { connect: [R_ETH_LED1.2, J_ETH.L1] }
    net ETH_LED1_K   { connect: [J_ETH.L2, U_PHY.3] }
    net ETH_LED2_A   { connect: [R_ETH_LED2.2, J_ETH.L3] }
    net ETH_LED2_K   { connect: [J_ETH.L4, U_PHY.2] }
    net ETH_SHIELD   { connect: [J_ETH.8, J_ETH.SH, C_ETH_SH.1] power_flag: true }

    // ========================================================================
    // NETS — SHEET 3: ISOLATED I/O (DOMAIN 2: ISO_IO_24V / ISO_IO_GND)
    // ========================================================================
    net MCU_DI1      { connect: [U_MCU.1, R_DIN_PU1.2, C_DIN_DB1.1, U_DIN1.4] }
    net MCU_DI2      { connect: [U_MCU.2, R_DIN_PU2.2, C_DIN_DB2.1, U_DIN2.4] }
    net MCU_DI3      { connect: [U_MCU.3, R_DIN_PU3.2, C_DIN_DB3.1, U_DIN3.4] }
    net MCU_DI4      { connect: [U_MCU.4, R_DIN_PU4.2, C_DIN_DB4.1, U_DIN4.4] }

    net DI1_IN       { connect: [J_DIN.1, R_DIN_LIM1.1] }
    net DI2_IN       { connect: [J_DIN.2, R_DIN_LIM2.1] }
    net DI3_IN       { connect: [J_DIN.3, R_DIN_LIM3.1] }
    net DI4_IN       { connect: [J_DIN.4, R_DIN_LIM4.1] }
    net DI1_ANODE    { connect: [R_DIN_LIM1.2, D_DIN_REV1.1, U_DIN1.1] }
    net DI2_ANODE    { connect: [R_DIN_LIM2.2, D_DIN_REV2.1, U_DIN2.1] }
    net DI3_ANODE    { connect: [R_DIN_LIM3.2, D_DIN_REV3.1, U_DIN3.1] }
    net DI4_ANODE    { connect: [R_DIN_LIM4.2, D_DIN_REV4.1, U_DIN4.1] }

    net MCU_DO1      { connect: [U_MCU.82, R_DO_LED1.1] }
    net MCU_DO2      { connect: [U_MCU.83, R_DO_LED2.1] }
    net MCU_DO3      { connect: [U_MCU.84, R_DO_LED3.1] }
    net MCU_DO4      { connect: [U_MCU.85, R_DO_LED4.1] }
    net DO1_OPTO_A   { connect: [R_DO_LED1.2, U_DOUT1.1] }
    net DO2_OPTO_A   { connect: [R_DO_LED2.2, U_DOUT2.1] }
    net DO3_OPTO_A   { connect: [R_DO_LED3.2, U_DOUT3.1] }
    net DO4_OPTO_A   { connect: [R_DO_LED4.2, U_DOUT4.1] }

    net ISO_IO_24V {
      connect: [
        J_ISO_PWR.1, C_ISO_BULK.1, C_ISO_DEC.1,
        R_DO_GTOP1.1, R_DO_GTOP2.1, R_DO_GTOP3.1, R_DO_GTOP4.1,
        K_RLY1.A1, K_RLY2.A1, K_RLY3.A1, K_RLY4.A1,
        D_FLY1.1, D_FLY2.1, D_FLY3.1, D_FLY4.1
      ]
    }
    net ISO_IO_GND {
      connect: [
        J_ISO_PWR.2, C_ISO_BULK.2, C_ISO_DEC.2,
        J_DIN.5, J_DIN.6,
        D_DIN_REV1.2, D_DIN_REV2.2, D_DIN_REV3.2, D_DIN_REV4.2,
        U_DIN1.2, U_DIN2.2, U_DIN3.2, U_DIN4.2,
        R_DO_GBOT1.2, R_DO_GBOT2.2, R_DO_GBOT3.2, R_DO_GBOT4.2,
        Q_RLY1.2, Q_RLY2.2, Q_RLY3.2, Q_RLY4.2
      ]
    }

    net DO1_COL      { connect: [R_DO_GTOP1.2, U_DOUT1.4] }
    net DO2_COL      { connect: [R_DO_GTOP2.2, U_DOUT2.4] }
    net DO3_COL      { connect: [R_DO_GTOP3.2, U_DOUT3.4] }
    net DO4_COL      { connect: [R_DO_GTOP4.2, U_DOUT4.4] }
    net DO1_GATE     { connect: [U_DOUT1.3, R_DO_GBOT1.1, Q_RLY1.1] }
    net DO2_GATE     { connect: [U_DOUT2.3, R_DO_GBOT2.1, Q_RLY2.1] }
    net DO3_GATE     { connect: [U_DOUT3.3, R_DO_GBOT3.1, Q_RLY3.1] }
    net DO4_GATE     { connect: [U_DOUT4.3, R_DO_GBOT4.1, Q_RLY4.1] }
    net RLY1_COIL_N  { connect: [Q_RLY1.3, K_RLY1.A2, D_FLY1.2] }
    net RLY2_COIL_N  { connect: [Q_RLY2.3, K_RLY2.A2, D_FLY2.2] }
    net RLY3_COIL_N  { connect: [Q_RLY3.3, K_RLY3.A2, D_FLY3.2] }
    net RLY4_COIL_N  { connect: [Q_RLY4.3, K_RLY4.A2, D_FLY4.2] }

    net RLY1_COM     { connect: [K_RLY1.11, J_RLY_12.1] }
    net RLY1_NO      { connect: [K_RLY1.14, J_RLY_12.2] }
    net RLY1_NC      { connect: [K_RLY1.12, J_RLY_12.3] }
    net RLY2_COM     { connect: [K_RLY2.11, J_RLY_12.4] }
    net RLY2_NO      { connect: [K_RLY2.14, J_RLY_12.5] }
    net RLY2_NC      { connect: [K_RLY2.12, J_RLY_12.6] }
    net RLY3_COM     { connect: [K_RLY3.11, J_RLY_34.1] }
    net RLY3_NO      { connect: [K_RLY3.14, J_RLY_34.2] }
    net RLY3_NC      { connect: [K_RLY3.12, J_RLY_34.3] }
    net RLY4_COM     { connect: [K_RLY4.11, J_RLY_34.4] }
    net RLY4_NO      { connect: [K_RLY4.14, J_RLY_34.5] }
    net RLY4_NC      { connect: [K_RLY4.12, J_RLY_34.6] }

    // ========================================================================
    // NETS — SHEET 4: ANALOG AFE & ISOLATED FIELDBUS (DOMAIN 3: ISO_BUS_5V / ISO_BUS_GND)
    // ========================================================================
    net GNDA {
      connect: [
        FB_AGND.1,
        J_AIN1.2, J_AIN1.3, R_AIN_BOT1.2, D_CLAMP_LO1.2, C_AAF1.2, U_OPA1.2, C_OPA1.2,
        J_AIN2.2, J_AIN2.3, R_AIN_BOT2.2, D_CLAMP_LO2.2, C_AAF2.2, U_OPA2.2, C_OPA2.2
      ]
      power_flag: true
    }
    net AIN1_IN      { connect: [J_AIN1.1, R_AIN_TOP1.1] }
    net AIN1_DIV     { connect: [R_AIN_TOP1.2, R_AIN_BOT1.1, D_CLAMP_HI1.2, D_CLAMP_LO1.1, R_AAF1.1] }
    net AIN1_FILT    { connect: [R_AAF1.2, C_AAF1.1, U_OPA1.1] }
    net MCU_ADC1     { connect: [U_OPA1.4, U_OPA1.3, U_MCU.23] }

    net AIN2_IN      { connect: [J_AIN2.1, R_AIN_TOP2.1] }
    net AIN2_DIV     { connect: [R_AIN_TOP2.2, R_AIN_BOT2.1, D_CLAMP_HI2.2, D_CLAMP_LO2.1, R_AAF2.1] }
    net AIN2_FILT    { connect: [R_AAF2.2, C_AAF2.1, U_OPA2.1] }
    net MCU_ADC2     { connect: [U_OPA2.4, U_OPA2.3, U_MCU.26] }

    net MCU_RS485_TX { connect: [U_MCU.86, U_ISO_RS485.VIB] }
    net MCU_RS485_RX { connect: [U_MCU.87, U_ISO_RS485.VOA] }
    net MCU_RS485_DE { connect: [U_MCU.88, R_RS485_DEL.1] }
    net RS485_DE_LED { connect: [R_RS485_DEL.2, U_ISO_DE.1] }

    net MCU_CAN_TX   { connect: [U_MCU.96, U_ISO_CAN.VIB] }
    net MCU_CAN_RX   { connect: [U_MCU.95, U_ISO_CAN.VOA] }

    net ISO_BUS_5V {
      connect: [
        J_BUS_PWR.1, C_BUS_BULK.1, C_BUS_DEC1.1, C_BUS_DEC2.1,
        U_ISO_RS485.VDD2, U_ISO_DE.4, U_ISO_CAN.VDD2,
        U_RS485.VCC, R_RS485_PU.1,
        U_CAN.VCC, C_CAN_DEC.1
      ]
      power_flag: true
    }
    net ISO_BUS_GND {
      connect: [
        J_BUS_PWR.2, C_BUS_BULK.2, C_BUS_DEC1.2, C_BUS_DEC2.2,
        U_ISO_RS485.GND2, U_ISO_CAN.GND2,
        U_RS485.GND, R_DE_PD.2, R_RS485_PD.2, D_TVS_485A.2, D_TVS_485B.2, J_RS485.3,
        U_CAN.GND, C_CAN_DEC.2, R_CAN_S.2, C_CAN_SPLIT.2, D_TVS_CANH.2, D_TVS_CANL.2, J_CAN.3
      ]
      power_flag: true
    }

    net ISO_RS485_RO { connect: [U_ISO_RS485.VIA, U_RS485.RO] }
    net ISO_RS485_DI { connect: [U_ISO_RS485.VOB, U_RS485.DI] }
    net ISO_RS485_DE { connect: [U_ISO_DE.3, R_DE_PD.1, U_RS485.DE, U_RS485.RE] }
    net RS485_A      { connect: [U_RS485.A, R_RS485_TERM.1, R_RS485_PU.2, D_TVS_485A.1, J_RS485.1] }
    net RS485_B      { connect: [U_RS485.B, R_RS485_TERM.2, R_RS485_PD.1, D_TVS_485B.1, J_RS485.2] }

    net ISO_CAN_RXD  { connect: [U_ISO_CAN.VIA, U_CAN.RXD] }
    net ISO_CAN_TXD  { connect: [U_ISO_CAN.VOB, U_CAN.TXD] }
    net CAN_S_PIN    { connect: [U_CAN.S, R_CAN_S.1] }
    net CAN_H        { connect: [U_CAN.CANH, R_CAN_T1.1, D_TVS_CANH.1, J_CAN.1] }
    net CAN_L        { connect: [U_CAN.CANL, R_CAN_T2.2, D_TVS_CANL.1, J_CAN.2] }
    net CAN_SPLIT    { connect: [R_CAN_T1.2, R_CAN_T2.1, C_CAN_SPLIT.1] }
  }

  // ==========================================================================
  // SCHEMATIC SHEET 1: POWER ARCHITECTURE (A2 Landscape: 594 x 420 mm)
  // ==========================================================================
  schematic Sheet1_Power {
    sheet: A2 landscape
    title: "Sheet 1: Industrial Power (24V/5V/3.3V/3.3VA)"
    routing { default: zone_local  power: symbol  ground: symbol }

    group Stage1_Input {
      title: "STAGE 1: 24V INPUT, PROTECTION & PI EMI FILTER"
      rect: (17.78mm, 17.78mm, 279.40mm, 165.10mm)
      border: dashed
      color: blue
      members: [J_PWR, F1, D_REV, D_TVS_24V, C_EMI1, C_EMI2, L_EMI, C_EMI3, C_EMI4, R_LED_24V, D_LED_24V, TP_24V]
      note: "24V Industrial Input | 2A Polyfuse | SS34 Reverse | SMBJ28A TVS | 50V Caps"
    }

    group Stage2_Buck5V {
      title: "STAGE 2: 24V -> 5V BUCK CONVERTER (LM2596S-ADJ)"
      rect: (294.64mm, 17.78mm, 556.26mm, 165.10mm)
      border: dashed
      color: amber
      members: [C_BUCK_IN1, C_BUCK_IN2, U_BUCK, D_BUCK, L_BUCK, C_BUCK_OUT1, C_BUCK_OUT2, R_FB_TOP, R_FB_BOT, C_FF, R_LED_5V, D_LED_5V, TP_5V]
      note: "Vout = 1.23V * (1 + 3.09k/1.0k) = 5.03V | 3A Max"
    }

    group Stage3_LDOs {
      title: "STAGE 3: 5V -> 3.3V DIGITAL & LOW-NOISE ANALOG (+3.3VA) LDOs"
      rect: (17.78mm, 182.88mm, 355.60mm, 355.60mm)
      border: dashed
      color: green
      members: [C_LDO1_IN, U_LDO_DIG, C_LDO1_OUT1, C_LDO1_OUT2, R_LED_3V3, D_LED_3V3, TP_3V3, C_LDO2_IN, U_LDO_ANA, C_LDO2_OUT1, FB_ANA, C_ANA_FILT1, C_ANA_FILT2, TP_3V3A]
      note: "Separate Digital +3V3 & Ferrite-Filtered Low-Noise Analog +3.3VA"
    }

    group Stage4_Supervisor {
      title: "STAGE 4: VOLTAGE SUPERVISOR & SYSTEM TEST POINTS"
      rect: (370.84mm, 182.88mm, 556.26mm, 355.60mm)
      border: dashed
      color: slate
      members: [C_SUP_DEC, R_SUP_TOP, R_SUP_BOT, U_SUP, C_SUP_CT, R_SUP_MR, R_PGOOD_PU, TP_PGOOD, TP_GND]
      note: "TPS3808 Voltage Supervisor | Monitors +3V3 -> SYS_PGOOD"
    }

    // Stage 1 placements
    place J_PWR      center (35.56mm, 68.58mm)  orient: 180
    place F1         center (63.50mm, 63.50mm)  orient: 90
    place D_REV      center (91.44mm, 63.50mm)  orient: 180
    place D_TVS_24V  center (116.84mm, 101.60mm) orient: 270
    place C_EMI1     center (137.16mm, 101.60mm)
    place C_EMI2     center (157.48mm, 101.60mm)
    place L_EMI      center (177.80mm, 63.50mm) orient: 90
    place C_EMI3     center (198.12mm, 101.60mm)
    place C_EMI4     center (218.44mm, 101.60mm)
    place R_LED_24V  center (241.30mm, 86.36mm)
    place D_LED_24V  center (241.30mm, 114.30mm) orient: 90
    place TP_24V     center (261.62mm, 63.50mm)

    // Stage 2 placements
    place C_BUCK_IN1 center (317.50mm, 101.60mm)
    place C_BUCK_IN2 center (337.82mm, 101.60mm)
    place U_BUCK     center (373.38mm, 68.58mm)
    place D_BUCK     center (408.94mm, 101.60mm) orient: 270
    place L_BUCK     center (429.26mm, 63.50mm)  orient: 90
    place C_BUCK_OUT1 center (452.12mm, 101.60mm)
    place C_BUCK_OUT2 center (472.44mm, 101.60mm)
    place R_FB_TOP   center (495.30mm, 81.28mm)
    place R_FB_BOT   center (495.30mm, 114.30mm)
    place C_FF       center (513.08mm, 81.28mm)
    place R_LED_5V   center (535.94mm, 86.36mm)
    place D_LED_5V   center (535.94mm, 114.30mm) orient: 90
    place TP_5V      center (538.48mm, 63.50mm)

    // Stage 3 placements (Top row: Digital 3.3V, Bottom row: Analog 3.3VA)
    place C_LDO1_IN   center (48.26mm, 236.22mm)
    place U_LDO_DIG   center (86.36mm, 223.52mm)
    place C_LDO1_OUT1 center (127.00mm, 236.22mm)
