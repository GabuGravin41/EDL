  // ==========================================================================
  // SCHEMATIC SHEET 2: STM32F407 MCU, ETHERNET PHY, FLASH/I2C & DEBUG
  // ==========================================================================
  schematic Sheet2_MCU_Ethernet {
    sheet: A2 landscape
    title: "Sheet 2: STM32F407 MCU, Ethernet PHY & Memory"
    routing { default: zone_local  power: symbol  ground: symbol }

    group MCU_Core {
      title: "MCU CORE: STM32F407VGT6, CLOCK, RESET & DECOUPLING"
      rect: (17.78mm, 17.78mm, 248.92mm, 264.16mm)
      border: dashed
      color: blue
      members: [U_MCU, C_MCU1, C_MCU2, C_MCU3, C_MCU4, C_MCU5, C_MCU6, C_MCU_BULK, C_VDDA1, C_VDDA2, C_VCAP1, C_VCAP2, Y_HSE, C_HSE1, C_HSE2, R_NRST, C_NRST, SW_RST, R_BOOT0, R_STAT_LED, D_STAT_LED]
      note: "STM32F407VGT6 168MHz | 8MHz HSE | 6x100nF + 4.7uF Shared Rail | 2x2.2uF VCAP"
    }

    group Debug_Memory {
      title: "DEBUG (SWD/UART), 128Mbit SPI FLASH & I2C TEMP SENSOR"
      rect: (17.78mm, 274.32mm, 248.92mm, 373.38mm)
      border: dashed
      color: green
      members: [J_SWD, J_UART, U_FLASH, C_FLASH, R_FL_WP, R_FL_HOLD, U_TEMP, C_TEMP, R_I2C_SDA, R_I2C_SCL, R_TEMP_OS]
      note: "10-Pin SWD | UART1 Debug | W25Q128JV SPI1 Flash | LM75C I2C1 (4.7k Pull-Ups)"
    }

    group Ethernet_PHY {
      title: "10/100 ETHERNET PHY (LAN8720A, RMII & 25MHz CLOCK)"
      rect: (264.16mm, 17.78mm, 563.88mm, 228.60mm)
      border: dashed
      color: amber
      members: [U_PHY, C_PHY1, C_PHY2, C_PHY3, C_PHY_BULK, C_VDDCR1, C_VDDCR2, R_RBIAS, Y_ETH, C_ETH_X1, C_ETH_X2, R_RMII_TXEN, R_RMII_TXD0, R_RMII_TXD1, R_RMII_RXD0, R_RMII_RXD1, R_RMII_CRSDV, R_RMII_CLK, R_MDIO_PU, R_PHY_RST]
      note: "LAN8720A RMII | 33R Series Damping | 12.1k RBIAS | 25MHz XTAL"
    }

    group Ethernet_RJ45 {
      title: "RJ45 MAGJACK, TERMINATION & LINK/ACT LEDs"
      rect: (264.16mm, 246.38mm, 563.88mm, 355.60mm)
      border: dashed
      color: slate
      members: [J_ETH, R_ETH_TXP, R_ETH_TXN, R_ETH_RXP, R_ETH_RXN, C_ETH_TCT, C_ETH_RCT, R_ETH_LED1, R_ETH_LED2, C_ETH_SH]
      note: "Bel SI-60062-F 10/100 MagJack | 49.9R Pull-Ups to +3V3"
    }

    // MCU Core placements (U_MCU is 50.8mm W x 144.8mm H -> center at x=165.10, y=144.78)
    place U_MCU      center (167.64mm, 147.32mm)
    // Shared horizontal decoupling rail along top of MCU_Core
    place C_MCU1     center (35.56mm, 45.72mm)
    place C_MCU2     center (50.80mm, 45.72mm)
    place C_MCU3     center (66.04mm, 45.72mm)
    place C_MCU4     center (81.28mm, 45.72mm)
    place C_MCU5     center (96.52mm, 45.72mm)
    place C_MCU6     center (111.76mm, 45.72mm)
    place C_MCU_BULK center (127.00mm, 45.72mm)
    // VDDA decoupling
    place C_VDDA1    center (213.36mm, 45.72mm)
    place C_VDDA2    center (231.14mm, 45.72mm)
    // Reset, BOOT0, HSE crystal, VCAPs on left of MCU
    place R_NRST     center (45.72mm, 91.44mm)
    place C_NRST     center (66.04mm, 91.44mm)
    place SW_RST     center (91.44mm, 91.44mm)
    place R_BOOT0    center (45.72mm, 124.46mm)
    place Y_HSE      center (63.50mm, 152.40mm)
    place C_HSE1     center (45.72mm, 177.80mm)
    place C_HSE2     center (81.28mm, 177.80mm)
    place C_VCAP1    center (45.72mm, 223.52mm)
    place C_VCAP2    center (68.58mm, 223.52mm)
    place R_STAT_LED center (223.52mm, 198.12mm)
    place D_STAT_LED center (223.52mm, 226.06mm) orient: 90

    // Debug & Memory placements
    place J_SWD      center (43.18mm, 312.42mm)
    place J_UART     center (43.18mm, 355.60mm) orient: 180
    place U_FLASH    center (114.30mm, 317.50mm)
    place C_FLASH    center (137.16mm, 317.50mm)
    place R_FL_WP    center (83.82mm, 353.06mm)
    place R_FL_HOLD  center (101.60mm, 353.06mm)
    place U_TEMP     center (198.12mm, 317.50mm)
    place C_TEMP     center (157.48mm, 317.50mm)
    place R_I2C_SCL  center (157.48mm, 353.06mm)
    place R_I2C_SDA  center (175.26mm, 353.06mm)
    place R_TEMP_OS  center (231.14mm, 353.06mm)

    // Ethernet PHY placements
    place C_PHY1     center (284.48mm, 45.72mm)
