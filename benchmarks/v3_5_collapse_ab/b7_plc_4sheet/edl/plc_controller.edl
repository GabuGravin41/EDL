    place R_RMII_TXD0  center (297.18mm, 106.68mm) orient: 90
    place R_RMII_TXD1  center (297.18mm, 121.92mm) orient: 90
    place R_RMII_RXD0  center (297.18mm, 137.16mm) orient: 90
    place R_RMII_RXD1  center (297.18mm, 152.40mm) orient: 90
    place R_RMII_CRSDV center (297.18mm, 167.64mm) orient: 90
    place R_RMII_CLK   center (297.18mm, 182.88mm) orient: 90
    // PHY center & 25MHz XTAL + RBIAS
