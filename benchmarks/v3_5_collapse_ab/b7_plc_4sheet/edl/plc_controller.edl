    place R_ETH_RXP  center (335.28mm, 279.40mm)
    place R_ETH_RXN  center (355.60mm, 279.40mm)
    place C_ETH_TCT  center (381.00mm, 279.40mm)
    place C_ETH_RCT  center (401.32mm, 279.40mm)
    place J_ETH      center (464.82mm, 297.18mm)
    place R_ETH_LED1 center (528.32mm, 276.86mm)
    place R_ETH_LED2 center (543.56mm, 276.86mm)
    place C_ETH_SH   center (464.82mm, 335.28mm)
  }

  // ==========================================================================
  // SCHEMATIC SHEET 3: GALVANICALLY ISOLATED 4-CH DI + 4-CH RELAY OUTPUTS
  // ==========================================================================
  schematic Sheet3_Isolated_IO {
    sheet: A2 landscape
    title: "Sheet 3: Isolated 4-Ch DI & 4-Ch 24V Relays"
    routing { default: zone_local  power: label_stub  ground: label_stub }

    // Vertical red dashed galvanic isolation barrier proved wire-crossing-free by E15!
    divider { from: (241.30mm, 17.78mm) to: (241.30mm, 365.76mm) label: "ISOLATION BARRIER" color: red }

    group DIN_Logic {
      title: "DIGITAL INPUTS — MCU LOGIC SIDE (+3V3 / GND)"
      rect: (17.78mm, 17.78mm, 203.20mm, 180.34mm)
      border: dashed
      color: blue
      members: [R_DIN_PU1, C_DIN_DB1, R_DIN_PU2, C_DIN_DB2, R_DIN_PU3, C_DIN_DB3, R_DIN_PU4, C_DIN_DB4]
      note: "10k Pull-Up + 100nF RC Debounce -> STM32 PE2..PE5"
    }

    group DIN_Optos {
      title: "DI BARRIER"
      rect: (218.44mm, 17.78mm, 264.16mm, 180.34mm)
      border: dashed
      color: red
      members: [U_DIN1, U_DIN2, U_DIN3, U_DIN4]
      note: "PC817 5kVrms"
    }

    group DIN_Field {
      title: "DIGITAL INPUTS — FIELD 24V SIDE (ISO_IO_GND)"
      rect: (279.40mm, 17.78mm, 563.88mm, 180.34mm)
      border: dashed
      color: red
      members: [R_DIN_LIM1, D_DIN_REV1, R_DIN_LIM2, D_DIN_REV2, R_DIN_LIM3, D_DIN_REV3, R_DIN_LIM4, D_DIN_REV4, J_DIN]
      note: "24V Field Inputs | 4.7k 0.25W Current Limit | 1N4148W Reverse Protection"
    }

    group DOUT_Logic {
      title: "RELAY OUTPUTS — MCU LOGIC SIDE (+3V3 / GND)"
      rect: (17.78mm, 195.58mm, 203.20mm, 365.76mm)
      border: dashed
      color: blue
      members: [R_DO_LED1, R_DO_LED2, R_DO_LED3, R_DO_LED4]
      note: "STM32 PD1..PD4 -> 330R Opto LED Drive"
    }

    group DOUT_Optos {
      title: "DO BARRIER"
      rect: (218.44mm, 195.58mm, 264.16mm, 365.76mm)
      border: dashed
      color: red
      members: [U_DOUT1, U_DOUT2, U_DOUT3, U_DOUT4]
      note: "PC817 5kVrms"
    }

    group DOUT_Field {
      title: "RELAY OUTPUTS — FIELD 24V DRIVERS & SPDT RELAYS (ISO_IO_24V / ISO_IO_GND)"
      rect: (279.40mm, 195.58mm, 563.88mm, 355.60mm)
      border: dashed
      color: amber
      members: [
        J_ISO_PWR, C_ISO_BULK, C_ISO_DEC,
        R_DO_GTOP1, R_DO_GBOT1, Q_RLY1, K_RLY1, D_FLY1,
        R_DO_GTOP2, R_DO_GBOT2, Q_RLY2, K_RLY2, D_FLY2,
        R_DO_GTOP3, R_DO_GBOT3, Q_RLY3, K_RLY3, D_FLY3,
        R_DO_GTOP4, R_DO_GBOT4, Q_RLY4, K_RLY4, D_FLY4,
        J_RLY_12, J_RLY_34
      ]
      note: "2N7002 Gate Divider (Vgs=9.6V) | G5LE-1-DC24 SPDT Relays | 1N4148W Flyback"
    }

    // DI Logic placements (4 horizontal rows)
    place R_DIN_PU1 center (76.20mm, 50.80mm)
    place C_DIN_DB1 center (139.70mm, 50.80mm)
    place R_DIN_PU2 center (76.20mm, 83.82mm)
    place C_DIN_DB2 center (139.70mm, 83.82mm)
    place R_DIN_PU3 center (76.20mm, 116.84mm)
    place C_DIN_DB3 center (139.70mm, 116.84mm)
    place R_DIN_PU4 center (76.20mm, 149.86mm)
    place C_DIN_DB4 center (139.70mm, 149.86mm)

    // DI Optocouplers straddling barrier x=241.30 (orient 180 -> pins 4,3 on west, pins 1,2 on east)
    place U_DIN1 center (241.30mm, 50.80mm)  orient: 180
    place U_DIN2 center (241.30mm, 83.82mm)  orient: 180
    place U_DIN3 center (241.30mm, 116.84mm) orient: 180
    place U_DIN4 center (241.30mm, 149.86mm) orient: 180

    // DI Field placements
    place D_DIN_REV1 center (325.12mm, 50.80mm)  orient: 270
    place R_DIN_LIM1 center (393.70mm, 50.80mm)  orient: 90
    place D_DIN_REV2 center (325.12mm, 83.82mm)  orient: 270
    place R_DIN_LIM2 center (393.70mm, 83.82mm)  orient: 90
    place D_DIN_REV3 center (325.12mm, 116.84mm) orient: 270
    place R_DIN_LIM3 center (393.70mm, 116.84mm) orient: 90
    place D_DIN_REV4 center (325.12mm, 149.86mm) orient: 270
    place R_DIN_LIM4 center (393.70mm, 149.86mm) orient: 90
    place J_DIN      center (520.70mm, 99.06mm)

    // DO Logic placements
    place R_DO_LED1 center (114.30mm, 231.14mm) orient: 90
    place R_DO_LED2 center (114.30mm, 266.70mm) orient: 90
    place R_DO_LED3 center (114.30mm, 302.26mm) orient: 90
    place R_DO_LED4 center (114.30mm, 337.82mm) orient: 90

    // DO Optocouplers straddling barrier x=241.30 (orient 0 -> pins 1,2 on west, pins 4,3 on east)
    place U_DOUT1 center (241.30mm, 231.14mm)
    place U_DOUT2 center (241.30mm, 266.70mm)
    place U_DOUT3 center (241.30mm, 302.26mm)
    place U_DOUT4 center (241.30mm, 337.82mm)

    // DO Field placements — 24V supply + 2x2 grid of relay channels + 2 output terminals
    place J_ISO_PWR  center (294.64mm, 226.06mm) orient: 180
    place C_ISO_BULK center (294.64mm, 269.24mm)
    place C_ISO_DEC  center (294.64mm, 309.88mm)

    // Channel 1 (top-left of DOUT_Field)
    place R_DO_GTOP1 center (330.20mm, 220.98mm)
    place R_DO_GBOT1 center (330.20mm, 254.00mm)
    place Q_RLY1     center (355.60mm, 241.30mm)
    place D_FLY1     center (378.46mm, 241.30mm) orient: 270
    place K_RLY1     center (401.32mm, 241.30mm)

    // Channel 2 (bottom-left of DOUT_Field)
    place R_DO_GTOP2 center (330.20mm, 294.64mm)
    place R_DO_GBOT2 center (330.20mm, 327.66mm)
    place Q_RLY2     center (355.60mm, 314.96mm)
    place D_FLY2     center (378.46mm, 314.96mm) orient: 270
    place K_RLY2     center (401.32mm, 314.96mm)

    // Channel 3 (top-right of DOUT_Field)
    place R_DO_GTOP3 center (436.88mm, 220.98mm)
    place R_DO_GBOT3 center (436.88mm, 254.00mm)
    place Q_RLY3     center (462.28mm, 241.30mm)
    place D_FLY3     center (485.14mm, 241.30mm) orient: 270
    place K_RLY3     center (508.00mm, 241.30mm)

    // Channel 4 (bottom-right of DOUT_Field)
    place R_DO_GTOP4 center (436.88mm, 294.64mm)
    place R_DO_GBOT4 center (436.88mm, 327.66mm)
    place Q_RLY4     center (462.28mm, 314.96mm)
    place D_FLY4     center (485.14mm, 314.96mm) orient: 270
    place K_RLY4     center (508.00mm, 314.96mm)

    place J_RLY_12   center (551.18mm, 241.30mm)
    place J_RLY_34   center (551.18mm, 314.96mm)
  }

  // ==========================================================================
  // SCHEMATIC SHEET 4: 2-CH ANALOG FRONT-END + ISOLATED RS-485 & CAN BUS
  // ==========================================================================
  schematic Sheet4_Analog_Fieldbus {
    sheet: A2 landscape
    title: "Sheet 4: 2-Ch AFE & Isolated RS-485 / CAN"
    routing { default: zone_local  power: label_stub  ground: label_stub }

    // Vertical red dashed galvanic isolation barrier proved wire-crossing-free by E15!
    divider { from: (304.80mm, 17.78mm) to: (304.80mm, 365.76mm) label: "ISOLATION BARRIER" color: red }

    group AFE_AnalogIn {
      title: "2-CH INDUSTRIAL ANALOG FRONT-END (0-10V / 4-20mA, +3.3VA)"
      rect: (17.78mm, 17.78mm, 266.70mm, 223.52mm)
      border: dashed
      color: green
      members: [
        J_AIN1, R_AIN_TOP1, R_AIN_BOT1, D_CLAMP_HI1, D_CLAMP_LO1, R_AAF1, C_AAF1, U_OPA1, C_OPA1,
        J_AIN2, R_AIN_TOP2, R_AIN_BOT2, D_CLAMP_HI2, D_CLAMP_LO2, R_AAF2, C_AAF2, U_OPA2, C_OPA2, FB_AGND
      ]
      note: "Ch1: 0-10V (24.9k/10k) | Ch2: 4-20mA (150R Burden) | BAT54 Clamps | LM321 Buffer"
    }

    group Fieldbus_Logic {
      title: "FIELDBUS LOGIC INTERFACE (+3V3 / GND)"
      rect: (17.78mm, 236.22mm, 266.70mm, 365.76mm)
      border: dashed
      color: blue
      members: [C_ISO_L1, C_ISO_L2, R_RS485_DEL]
      note: "Logic-Side Decoupling & RS-485 DE Opto Drive"
    }

    group Fieldbus_Barrier {
      title: "BUS BARRIER"
      rect: (279.40mm, 17.78mm, 330.20mm, 355.60mm)
      border: dashed
      color: red
      members: [U_ISO_RS485, U_ISO_DE, U_ISO_CAN]
      note: "ADuM1201 + PC817"
    }

    group RS485_Isolated {
      title: "ISOLATED RS-485 TRANSCEIVER (LTC2850, ISO_BUS_5V / ISO_BUS_GND)"
      rect: (345.44mm, 17.78mm, 563.88mm, 180.34mm)
      border: dashed
      color: red
      members: [J_BUS_PWR, C_BUS_BULK, C_BUS_DEC1, C_BUS_DEC2, U_RS485, R_DE_PD, R_RS485_TERM, R_RS485_PU, R_RS485_PD, D_TVS_485A, D_TVS_485B, J_RS485]
      note: "120R Term | 680R Fail-Safe Bias | SMBJ12A TVS | Isolated Domain 3"
    }

    group CAN_Isolated {
      title: "ISOLATED CAN BUS TRANSCEIVER (TJA1051T, ISO_BUS_5V / ISO_BUS_GND)"
      rect: (345.44mm, 195.58mm, 563.88mm, 355.60mm)
      border: dashed
      color: amber
      members: [U_CAN, C_CAN_DEC, R_CAN_S, R_CAN_T1, R_CAN_T2, C_CAN_SPLIT, D_TVS_CANH, D_TVS_CANL, J_CAN]
      note: "TJA1051T | 120R Split Term (60.4R + 60.4R + 4.7nF) | SMBJ12A TVS"
    }

    // Analog Front-End placements (Ch1 top row, Ch2 bottom row)
    place J_AIN1      center (38.10mm, 73.66mm)  orient: 180
    place R_AIN_TOP1  center (68.58mm, 66.04mm)  orient: 90
    place R_AIN_BOT1  center (96.52mm, 93.98mm)
    place D_CLAMP_HI1 center (119.38mm, 48.26mm) orient: 270
    place D_CLAMP_LO1 center (119.38mm, 93.98mm) orient: 270
    place R_AAF1      center (144.78mm, 66.04mm) orient: 90
    place C_AAF1      center (167.64mm, 93.98mm)
    place U_OPA1      center (208.28mm, 71.12mm)
    place C_OPA1      center (243.84mm, 71.12mm)

    place J_AIN2      center (38.10mm, 165.10mm) orient: 180
    place R_AIN_TOP2  center (68.58mm, 157.48mm) orient: 90
    place R_AIN_BOT2  center (96.52mm, 185.42mm)
    place D_CLAMP_HI2 center (119.38mm, 139.70mm) orient: 270
    place D_CLAMP_LO2 center (119.38mm, 185.42mm) orient: 270
    place R_AAF2      center (144.78mm, 157.48mm) orient: 90
    place C_AAF2      center (167.64mm, 185.42mm)
    place U_OPA2      center (208.28mm, 162.56mm)
    place C_OPA2      center (243.84mm, 162.56mm)
    place FB_AGND     center (243.84mm, 200.66mm) orient: 90

    // Fieldbus logic-side helpers
    place C_ISO_L1    center (76.20mm, 292.10mm)
    place C_ISO_L2    center (127.00mm, 292.10mm)
    place R_RS485_DEL center (193.04mm, 292.10mm) orient: 90

    // Isolators centered strictly on barrier x = 304.80mm
    place U_ISO_RS485 center (304.80mm, 76.20mm)
    place U_ISO_DE    center (304.80mm, 144.78mm)
    place U_ISO_CAN   center (304.80mm, 269.24mm)

    // Isolated RS-485 placements
    place J_BUS_PWR    center (368.30mm, 55.88mm) orient: 180
    place C_BUS_BULK   center (414.02mm, 55.88mm)
    place C_BUS_DEC1   center (434.34mm, 55.88mm)
    place C_BUS_DEC2   center (454.66mm, 55.88mm)
    place R_DE_PD      center (365.76mm, 129.54mm)
    place U_RS485      center (421.64mm, 114.30mm)
    place R_RS485_PU   center (469.90mm, 78.74mm)
    place R_RS485_TERM center (469.90mm, 114.30mm)
    place R_RS485_PD   center (469.90mm, 149.86mm)
    place D_TVS_485A   center (502.92mm, 93.98mm)  orient: 270
    place D_TVS_485B   center (502.92mm, 134.62mm) orient: 270
    place J_RS485      center (543.56mm, 114.30mm)

    // Isolated CAN placements
    place C_CAN_DEC    center (370.84mm, 241.30mm)
    place R_CAN_S      center (370.84mm, 287.02mm)
    place U_CAN        center (421.64mm, 269.24mm)
    place R_CAN_T1     center (469.90mm, 248.92mm)
    place R_CAN_T2     center (469.90mm, 289.56mm)
    place C_CAN_SPLIT  center (495.30mm, 314.96mm)
    place D_TVS_CANH   center (513.08mm, 248.92mm) orient: 270
    place D_TVS_CANL   center (513.08mm, 289.56mm) orient: 270
    place J_CAN        center (543.56mm, 269.24mm)
  }

  verify {
    require all_required_pins_connected
    require no_power_ground_short
    require no_multiple_power_drivers
    require voltage_compatibility
    require no_single_pin_nets
    require ic_decoupling
    require bom_manufacturability
    require i2c_pullups
    require inductive_flyback
    require galvanic_isolation(GND, ISO_IO_GND)
    require galvanic_isolation(GND, ISO_BUS_GND)
    require galvanic_isolation(ISO_IO_GND, ISO_BUS_GND)
  }
}
