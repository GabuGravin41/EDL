// ============================================================================
// Industrial 4-Sheet Hierarchical PLC & Ethernet/Fieldbus Controller
// EDL v3.5.0 — 3 Galvanic Isolation Domains (GND, ISO_IO_GND, ISO_BUS_GND)
// Sheets:
//   1. Sheet1_Power          : 24V -> 5V Buck -> 3.3V Digital + 3.3VA Analog + Supervisor
//   2. Sheet2_MCU_Ethernet   : STM32F407 MCU, LAN8720A Ethernet PHY + RJ45, Flash, I2C Temp, SWD
//   3. Sheet3_Isolated_IO    : Galvanically Isolated 4-Ch 24V DI + 4-Ch 24V Relay Outputs
//   4. Sheet4_Analog_Fieldbus: 2-Ch 0-10V/4-20mA AFE + Isolated RS-485 & CAN Bus
// ============================================================================

project "Industrial_PLC_Controller" {
  units: mm
  frame Sheet: Frame2

  circuit Main {

    // ========================================================================
    // SHEET 1: MULTI-RAIL INDUSTRIAL POWER ARCHITECTURE (48 components)
    // ========================================================================

    // --- Stage 1: 24V Industrial Input, Fuse, Reverse Schottky, TVS, Pi EMI Filter ---
    component J_PWR:      "Connector:Screw_Terminal_01x02" { value: "24V_IN"     footprint: "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-1,5-2-5.08_1x02_P5.08mm_Horizontal" }
    component F1:         "Device:Polyfuse"                { value: "2.0A"       footprint: "Fuse:Fuse_1812_4532Metric" }
    component D_REV:      "Device:D_Schottky"              { value: "SS34"       footprint: "Diode_SMD:D_SMA" }
    component D_TVS_24V:  "Device:D_TVS"                   { value: "SMBJ28A"    footprint: "Diode_SMD:D_SMB" }
    component C_EMI1:     "Device:C"                       { value: 100nF  voltage_rating: 50V  footprint: "Capacitor_SMD:C_0805_2012Metric" }
    component C_EMI2:     "Device:C_Polarized"             { value: 47uF   voltage_rating: 50V  footprint: "Capacitor_SMD:CP_Elec_8x10" }
    component L_EMI:      "Device:L"                       { value: "10uH"       footprint: "Inductor_SMD:L_1210_3225Metric" }
    component C_EMI3:     "Device:C"                       { value: 100nF  voltage_rating: 50V  footprint: "Capacitor_SMD:C_0805_2012Metric" }
    component C_EMI4:     "Device:C_Polarized"             { value: 100uF  voltage_rating: 50V  footprint: "Capacitor_SMD:CP_Elec_8x10" }
    component R_LED_24V:  "Device:R"                       { value: 4.7kOhm   power_rating: 0.25W  footprint: "Resistor_SMD:R_1206_3216Metric" }
    component D_LED_24V:  "Device:LED"                     { value: "GREEN_24V"  footprint: "LED_SMD:LED_0603_1608Metric" }
    component TP_24V:     "Connector:TestPoint"            { value: "TP_24V"     footprint: "TestPoint:TestPoint_Pad_D1.5mm" }

    // --- Stage 2: 24V -> 5V Buck Converter (LM2596S-ADJ) ---
    component U_BUCK:     "Regulator_Switching:LM2596S-ADJ" {
      value: "LM2596S-ADJ"
      footprint: "Package_TO_SOT_SMD:TO-263-5_TabPin3"
      pin VIN: power_in(7V..40V)
    }
    component C_BUCK_IN1: "Device:C"                       { value: 100nF  voltage_rating: 50V  footprint: "Capacitor_SMD:C_0805_2012Metric" }
    component C_BUCK_IN2: "Device:C_Polarized"             { value: 220uF  voltage_rating: 50V  footprint: "Capacitor_THT:CP_Radial_D8.0mm_P3.50mm" }
    component D_BUCK:     "Device:D_Schottky"              { value: "SS54"       footprint: "Diode_SMD:D_SMB" }
    component L_BUCK:     "Device:L"                       { value: "33uH"       footprint: "Inductor_SMD:L_Bourns_SRR1260" }
    component C_BUCK_OUT1:"Device:C_Polarized"             { value: 220uF  voltage_rating: 25V  footprint: "Capacitor_SMD:CP_Elec_8x10" }
    component C_BUCK_OUT2:"Device:C"                       { value: 100nF  voltage_rating: 25V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component R_FB_TOP:   "Device:R"                       { value: 3.09kOhm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_FB_BOT:   "Device:R"                       { value: 1.0kOhm   power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component C_FF:       "Device:C"                       { value: 10nF   voltage_rating: 25V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component R_LED_5V:   "Device:R"                       { value: 1.0kOhm   power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component D_LED_5V:   "Device:LED"                     { value: "GREEN_5V"   footprint: "LED_SMD:LED_0603_1608Metric" }
    component TP_5V:      "Connector:TestPoint"            { value: "TP_5V"      footprint: "TestPoint:TestPoint_Pad_D1.5mm" }

    // --- Stage 3: 5V -> 3.3V Digital LDO & 5V -> 3.3VA Low-Noise Analog LDO ---
    component U_LDO_DIG:  "Regulator_Linear:AMS1117-3.3" {
      value: "AMS1117-3.3"
      footprint: "Package_TO_SOT_SMD:SOT-223-3_TabPin2"
      pin VI: power_in(4.5V..15V)
      pin VO: power_out(3.3V)
    }
    component C_LDO1_IN:  "Device:C"                       { value: 10uF   voltage_rating: 16V  footprint: "Capacitor_SMD:C_0805_2012Metric" }
    component C_LDO1_OUT1:"Device:C"                       { value: 22uF   voltage_rating: 16V  footprint: "Capacitor_SMD:C_0805_2012Metric" }
    component C_LDO1_OUT2:"Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component R_LED_3V3:  "Device:R"                       { value: 470Ohm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component D_LED_3V3:  "Device:LED"                     { value: "BLUE_3V3"   footprint: "LED_SMD:LED_0603_1608Metric" }
    component TP_3V3:     "Connector:TestPoint"            { value: "TP_3V3"     footprint: "TestPoint:TestPoint_Pad_D1.5mm" }

    component U_LDO_ANA:  "Regulator_Linear:AMS1117-3.3" {
      value: "AMS1117-3.3"
      footprint: "Package_TO_SOT_SMD:SOT-223-3_TabPin2"
      pin VI: power_in(4.5V..15V)
      pin VO: power_out(3.3V)
    }
    component C_LDO2_IN:  "Device:C"                       { value: 10uF   voltage_rating: 16V  footprint: "Capacitor_SMD:C_0805_2012Metric" }
    component C_LDO2_OUT1:"Device:C"                       { value: 22uF   voltage_rating: 16V  footprint: "Capacitor_SMD:C_0805_2012Metric" }
    component FB_ANA:     "Device:FerriteBead"             { value: "600R@100MHz" footprint: "Inductor_SMD:L_0805_2012Metric" }
    component C_ANA_FILT1:"Device:C"                       { value: 10uF   voltage_rating: 16V  footprint: "Capacitor_SMD:C_0805_2012Metric" }
    component C_ANA_FILT2:"Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component TP_3V3A:    "Connector:TestPoint"            { value: "TP_3V3A"    footprint: "TestPoint:TestPoint_Pad_D1.5mm" }

    // --- Stage 4: Voltage Supervisor & Reference Test Points ---
    component U_SUP:      "Power_Supervisor:TPS3808DBV" {
      value: "TPS3808G01"
      footprint: "Package_TO_SOT_SMD:SOT-23-6"
      pin VDD: power_in(1.7V..6.5V)
    }
    component C_SUP_DEC:  "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component R_SUP_TOP:  "Device:R"                       { value: 100kOhm   power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_SUP_BOT:  "Device:R"                       { value: 15kOhm    power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component C_SUP_CT:   "Device:C"                       { value: 10nF   voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component R_SUP_MR:   "Device:R"                       { value: 10kOhm    power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_PGOOD_PU: "Device:R"                       { value: 10kOhm    power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component TP_PGOOD:   "Connector:TestPoint"            { value: "TP_PGOOD"   footprint: "TestPoint:TestPoint_Pad_D1.5mm" }
    component TP_GND:     "Connector:TestPoint"            { value: "TP_GND"     footprint: "TestPoint:TestPoint_Pad_D1.5mm" }

    // ========================================================================
    // SHEET 2: STM32F407 MCU CORE, ETHERNET PHY, FLASH/I2C & DEBUG (60 components)
    // ========================================================================

    // --- MCU Core ---
    component U_MCU:      "MCU_ST_STM32F4:STM32F407V_E-G_Tx" {
      value: "STM32F407VGT6"
      footprint: "Package_QFP:LQFP-100_14x14mm_P0.5mm"
      no_connect: [PE7, PE8, PE9, PE10, PE11, PE12, PE13, PE14, PE15, PD8, PD9, PD10, PD11, PD12, PD13, PD14, PD15, PA8, PA11, PA12, PA15, PB0, PB1, PB2, PB4, PB10, PB14, PB15, PC0, PC2, PC3, PC6, PC7, PC8, PC9, PC10, PC11, PC12, PC13, PC14, PC15]
    }
    component C_MCU1:     "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_MCU2:     "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_MCU3:     "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_MCU4:     "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_MCU5:     "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_MCU6:     "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_MCU_BULK: "Device:C"                       { value: 4.7uF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0805_2012Metric" }
    component C_VDDA1:    "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_VDDA2:    "Device:C"                       { value: 1uF    voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_VCAP1:    "Device:C"                       { value: 2.2uF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_VCAP2:    "Device:C"                       { value: 2.2uF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component Y_HSE:      "Device:Crystal"                 { value: "8MHz"       footprint: "Crystal:Crystal_SMD_HC49-SD" }
    component C_HSE1:     "Device:C"                       { value: 18pF   voltage_rating: 50V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_HSE2:     "Device:C"                       { value: 18pF   voltage_rating: 50V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component R_NRST:     "Device:R"                       { value: 10kOhm    power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component C_NRST:     "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component SW_RST:     "Switch:SW_Push"                 { value: "RESET"      footprint: "Button_Switch_SMD:SW_SPST_TL3342" }
    component R_BOOT0:    "Device:R"                       { value: 10kOhm    power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_STAT_LED: "Device:R"                       { value: 470Ohm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component D_STAT_LED: "Device:LED"                     { value: "GREEN_RUN"  footprint: "LED_SMD:LED_0603_1608Metric" }

    // --- Debug, SPI Flash & I2C Temperature Sensor ---
    component J_SWD:      "Connector_Generic:Conn_02x05_Odd_Even" { value: "SWD_10P"  footprint: "Connector_PinHeader_1.27mm:PinHeader_2x05_P1.27mm_Vertical"  no_connect: [Pin_7, Pin_8] }
    component J_UART:     "Connector_Generic:Conn_01x04"          { value: "DBG_UART" footprint: "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical" }
    component U_FLASH:    "Memory_Flash:W25Q128JVS" {
      value: "W25Q128JV"
      footprint: "Package_SO:SOIC-8_5.3x5.3mm_P1.27mm"
      pin VCC: power_in(2.7V..3.6V)
    }
    component C_FLASH:    "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component R_FL_WP:    "Device:R"                       { value: 10kOhm    power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_FL_HOLD:  "Device:R"                       { value: 10kOhm    power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component U_TEMP:     "Sensor_Temperature:LM75C" {
      value: "LM75CIM"
      footprint: "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm"
    }
    component C_TEMP:     "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component R_I2C_SDA:  "Device:R"                       { value: 4.7kOhm   power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_I2C_SCL:  "Device:R"                       { value: 4.7kOhm   power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_TEMP_OS:  "Device:R"                       { value: 10kOhm    power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }

    // --- Ethernet PHY (LAN8720A) ---
    component U_PHY:      "Interface_Ethernet:LAN8720A" {
      value: "LAN8720A"
      footprint: "Package_DFN_QFN:VQFN-24-1EP_4x4mm_P0.5mm_EP2.5x2.5mm_ThermalVias"
      no_connect: ["RXER/PHYAD0"]
    }
    component C_PHY1:     "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_PHY2:     "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_PHY3:     "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_PHY_BULK: "Device:C"                       { value: 10uF   voltage_rating: 16V  footprint: "Capacitor_SMD:C_0805_2012Metric" }
    component C_VDDCR1:   "Device:C"                       { value: 1uF    voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_VDDCR2:   "Device:C"                       { value: 470pF  voltage_rating: 50V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component R_RBIAS:    "Device:R"                       { value: 12.1kOhm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component Y_ETH:      "Device:Crystal"                 { value: "25MHz"      footprint: "Crystal:Crystal_SMD_HC49-SD" }
    component C_ETH_X1:   "Device:C"                       { value: 18pF   voltage_rating: 50V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_ETH_X2:   "Device:C"                       { value: 18pF   voltage_rating: 50V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component R_RMII_TXEN:"Device:R"                       { value: 33Ohm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_RMII_TXD0:"Device:R"                       { value: 33Ohm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_RMII_TXD1:"Device:R"                       { value: 33Ohm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_RMII_RXD0:"Device:R"                       { value: 33Ohm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_RMII_RXD1:"Device:R"                       { value: 33Ohm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_RMII_CRSDV:"Device:R"                      { value: 33Ohm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_RMII_CLK: "Device:R"                       { value: 33Ohm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_MDIO_PU:  "Device:R"                       { value: 1.5kOhm   power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_PHY_RST:  "Device:R"                       { value: 10kOhm    power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }

    // --- RJ45 MagJack & Termination ---
    component J_ETH:      "Connector:RJ45_Bel_SI-60062-F"  { value: "RJ45_MAG"   footprint: "Connector_RJ:RJ45_Bel_SI-60062-F" }
    component R_ETH_TXP:  "Device:R"                       { value: 49.9Ohm  power_rating: 0.5W   footprint: "Resistor_SMD:R_1206_3216Metric" }
    component R_ETH_TXN:  "Device:R"                       { value: 49.9Ohm  power_rating: 0.5W   footprint: "Resistor_SMD:R_1206_3216Metric" }
    component R_ETH_RXP:  "Device:R"                       { value: 49.9Ohm  power_rating: 0.5W   footprint: "Resistor_SMD:R_1206_3216Metric" }
    component R_ETH_RXN:  "Device:R"                       { value: 49.9Ohm  power_rating: 0.5W   footprint: "Resistor_SMD:R_1206_3216Metric" }
    component C_ETH_TCT:  "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_ETH_RCT:  "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component R_ETH_LED1: "Device:R"                       { value: 330Ohm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_ETH_LED2: "Device:R"                       { value: 330Ohm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component C_ETH_SH:   "Device:C"                       { value: 1nF    voltage_rating: 100V footprint: "Capacitor_SMD:C_1206_3216Metric" }

    // ========================================================================
    // SHEET 3: GALVANICALLY ISOLATED 4-CH DIGITAL INPUTS + 4-CH RELAY OUTPUTS (54 components)
    // ========================================================================

    // --- 4-Ch Digital Inputs (Logic Side) ---
    component R_DIN_PU1:  "Device:R"                       { value: 10kOhm    power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_DIN_PU2:  "Device:R"                       { value: 10kOhm    power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_DIN_PU3:  "Device:R"                       { value: 10kOhm    power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_DIN_PU4:  "Device:R"                       { value: 10kOhm    power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component C_DIN_DB1:  "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_DIN_DB2:  "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_DIN_DB3:  "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }
    component C_DIN_DB4:  "Device:C"                       { value: 100nF  voltage_rating: 16V  footprint: "Capacitor_SMD:C_0603_1608Metric" }

    // --- 4-Ch Digital Input Optocouplers (Barrier) ---
    component U_DIN1:     "Isolator:PC817"                 { value: "PC817"      footprint: "Package_DIP:DIP-4_W7.62mm" }
    component U_DIN2:     "Isolator:PC817"                 { value: "PC817"      footprint: "Package_DIP:DIP-4_W7.62mm" }
    component U_DIN3:     "Isolator:PC817"                 { value: "PC817"      footprint: "Package_DIP:DIP-4_W7.62mm" }
    component U_DIN4:     "Isolator:PC817"                 { value: "PC817"      footprint: "Package_DIP:DIP-4_W7.62mm" }

    // --- 4-Ch Digital Inputs (Field Side — ISO_IO_GND) ---
    component J_DIN:      "Connector:Screw_Terminal_01x06" { value: "DIN_24V_CH1-4" footprint: "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-1,5-6-5.08_1x06_P5.08mm_Horizontal" }
    component R_DIN_LIM1: "Device:R"                       { value: 4.7kOhm   power_rating: 0.25W  footprint: "Resistor_SMD:R_1206_3216Metric" }
    component R_DIN_LIM2: "Device:R"                       { value: 4.7kOhm   power_rating: 0.25W  footprint: "Resistor_SMD:R_1206_3216Metric" }
    component R_DIN_LIM3: "Device:R"                       { value: 4.7kOhm   power_rating: 0.25W  footprint: "Resistor_SMD:R_1206_3216Metric" }
    component R_DIN_LIM4: "Device:R"                       { value: 4.7kOhm   power_rating: 0.25W  footprint: "Resistor_SMD:R_1206_3216Metric" }
    component D_DIN_REV1: "Device:D"                       { value: "1N4148W"    footprint: "Diode_SMD:D_SOD-123" }
    component D_DIN_REV2: "Device:D"                       { value: "1N4148W"    footprint: "Diode_SMD:D_SOD-123" }
    component D_DIN_REV3: "Device:D"                       { value: "1N4148W"    footprint: "Diode_SMD:D_SOD-123" }
    component D_DIN_REV4: "Device:D"                       { value: "1N4148W"    footprint: "Diode_SMD:D_SOD-123" }

    // --- 4-Ch Relay Outputs (Logic Side) ---
    component R_DO_LED1:  "Device:R"                       { value: 330Ohm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
    component R_DO_LED2:  "Device:R"                       { value: 330Ohm  power_rating: 0.1W   footprint: "Resistor_SMD:R_0603_1608Metric" }
