    net DBG_RX       { connect: [U_MCU.69, J_UART.3] }

    net SPI_CS       { connect: [U_MCU.29, U_FLASH.1] }
    net SPI_SCK      { connect: [U_MCU.30, U_FLASH.6] }
    net SPI_MISO     { connect: [U_MCU.31, U_FLASH.2] }
    net SPI_MOSI     { connect: [U_MCU.91, U_FLASH.5] }
    net FL_WP        { connect: [R_FL_WP.2, U_FLASH.3] }
    net FL_HOLD      { connect: [R_FL_HOLD.2, U_FLASH.7] }

    net I2C_SCL      { connect: [U_MCU.92, U_TEMP.2, R_I2C_SCL.2] }
    net I2C_SDA      { connect: [U_MCU.93, U_TEMP.1, R_I2C_SDA.2] }
    net TEMP_OS      { connect: [U_MCU.5, U_TEMP.3, R_TEMP_OS.2] }

    // Ethernet PHY & RMII
    net PHY_VDDCR    { connect: [U_PHY.6, C_VDDCR1.1, C_VDDCR2.1] power_flag: true }
    net PHY_RBIAS    { connect: [U_PHY.24, R_RBIAS.1] }
    net ETH_XI       { connect: [U_PHY.5, Y_ETH.1, C_ETH_X1.1] }
    net ETH_XO       { connect: [U_PHY.4, Y_ETH.2, C_ETH_X2.1] }
