    // ========================================================================
    // NETS — DOMAIN 1: MAIN POWER & GROUND (GND, +24V, +5V, +3V3, +3.3VA)
    // ========================================================================
    net "+24V" {
      connect: [J_PWR.1, F1.1]
      power_flag: true
    }
    net IN_FUSED { connect: [F1.2, D_REV.2] }
    net IN_PROT  { connect: [D_REV.1, D_TVS_24V.1, C_EMI1.1, C_EMI2.1, L_EMI.1] }
    net IN_FILT  { connect: [L_EMI.2, C_EMI3.1, C_EMI4.1, R_LED_24V.1, TP_24V.1, C_BUCK_IN1.1, C_BUCK_IN2.1, U_BUCK.VIN] }
    net LED_24V_A { connect: [R_LED_24V.2, D_LED_24V.2] }
    net BUCK_SW   { connect: [U_BUCK.OUT, D_BUCK.1, L_BUCK.1] }
    net BUCK_FB   { connect: [U_BUCK.FB, R_FB_TOP.2, R_FB_BOT.1, C_FF.2] }

    net "+5V" {
      connect: [
        L_BUCK.2, C_BUCK_OUT1.1, C_BUCK_OUT2.1, R_FB_TOP.1, C_FF.1, R_LED_5V.1, TP_5V.1,
        C_LDO1_IN.1, U_LDO_DIG.VI, C_LDO2_IN.1, U_LDO_ANA.VI
      ]
      power_flag: true
    }
    net LED_5V_A  { connect: [R_LED_5V.2, D_LED_5V.2] }

    net "+3V3" {
      connect: [
        U_LDO_DIG.VO, C_LDO1_OUT1.1, C_LDO1_OUT2.1, R_LED_3V3.1, TP_3V3.1,
        U_SUP.VDD, C_SUP_DEC.1, R_SUP_TOP.1, R_SUP_MR.1, R_PGOOD_PU.1,
        U_MCU.6, U_MCU.11, U_MCU.19, U_MCU.28, U_MCU.50, U_MCU.75, U_MCU.100,
        C_MCU1.1, C_MCU2.1, C_MCU3.1, C_MCU4.1, C_MCU5.1, C_MCU6.1, C_MCU_BULK.1,
        R_NRST.1, J_SWD.1, J_UART.1,
        U_FLASH.VCC, C_FLASH.1, R_FL_WP.1, R_FL_HOLD.1,
        U_TEMP.8, C_TEMP.1, R_I2C_SDA.1, R_I2C_SCL.1, R_TEMP_OS.1,
        U_PHY.9, U_PHY.19, U_PHY.1, C_PHY1.1, C_PHY2.1, C_PHY3.1, C_PHY_BULK.1,
        R_MDIO_PU.1, R_PHY_RST.1,
        J_ETH.2, J_ETH.5, R_ETH_TXP.1, R_ETH_TXN.1, R_ETH_RXP.1, R_ETH_RXN.1,
        C_ETH_TCT.1, C_ETH_RCT.1, R_ETH_LED1.1, R_ETH_LED2.1,
        R_DIN_PU1.1, R_DIN_PU2.1, R_DIN_PU3.1, R_DIN_PU4.1,
        C_ISO_L1.1, C_ISO_L2.1, U_ISO_RS485.VDD1, U_ISO_CAN.VDD1
      ]
    }
    net LED_3V3_A { connect: [R_LED_3V3.2, D_LED_3V3.2] }

    net VAA { connect: [U_LDO_ANA.VO, C_LDO2_OUT1.1, FB_ANA.1] }
    net "+3.3VA" {
      connect: [
        FB_ANA.2, C_ANA_FILT1.1, C_ANA_FILT2.1, TP_3V3A.1,
        U_MCU.22, U_MCU.21, C_VDDA1.1, C_VDDA2.1,
        D_CLAMP_HI1.1, D_CLAMP_HI2.1, U_OPA1.5, U_OPA2.5, C_OPA1.1, C_OPA2.1
      ]
      power_flag: true
    }

    net SUP_SENSE { connect: [R_SUP_TOP.2, R_SUP_BOT.1, U_SUP.SENSE] }
    net SUP_CT    { connect: [U_SUP.CT, C_SUP_CT.1] }
    net SUP_MR    { connect: [R_SUP_MR.2, U_SUP.MR] }
    net SYS_PGOOD { connect: [U_SUP.RESET, R_PGOOD_PU.2, TP_PGOOD.1, U_MCU.97] }

    net GND {
      connect: [
        J_PWR.2, D_TVS_24V.2, C_EMI1.2, C_EMI2.2, C_EMI3.2, C_EMI4.2, D_LED_24V.1,
        U_BUCK.GND, U_BUCK.5, C_BUCK_IN1.2, C_BUCK_IN2.2, D_BUCK.2, C_BUCK_OUT1.2, C_BUCK_OUT2.2, R_FB_BOT.2, D_LED_5V.1,
        U_LDO_DIG.GND, C_LDO1_IN.2, C_LDO1_OUT1.2, C_LDO1_OUT2.2, D_LED_3V3.1,
        U_LDO_ANA.GND, C_LDO2_IN.2, C_LDO2_OUT1.2, C_ANA_FILT1.2, C_ANA_FILT2.2,
        U_SUP.GND, C_SUP_DEC.2, R_SUP_BOT.2, C_SUP_CT.2, TP_GND.1,
        U_MCU.10, U_MCU.20,
        C_MCU1.2, C_MCU2.2, C_MCU3.2, C_MCU4.2, C_MCU5.2, C_MCU6.2, C_MCU_BULK.2,
        C_VDDA1.2, C_VDDA2.2, C_VCAP1.2, C_VCAP2.2, C_HSE1.2, C_HSE2.2,
        C_NRST.2, SW_RST.2, R_BOOT0.2, D_STAT_LED.1,
        J_SWD.3, J_SWD.5, J_SWD.9, J_UART.4,
        U_FLASH.GND, C_FLASH.2,
        U_TEMP.4, U_TEMP.5, U_TEMP.6, U_TEMP.7, C_TEMP.2,
        U_PHY.25, C_PHY1.2, C_PHY2.2, C_PHY3.2, C_PHY_BULK.2, C_VDDCR1.2, C_VDDCR2.2,
        R_RBIAS.2, C_ETH_X1.2, C_ETH_X2.2,
        C_ETH_TCT.2, C_ETH_RCT.2, C_ETH_SH.2,
        C_DIN_DB1.2, C_DIN_DB2.2, C_DIN_DB3.2, C_DIN_DB4.2,
        U_DIN1.3, U_DIN2.3, U_DIN3.3, U_DIN4.3,
        U_DOUT1.2, U_DOUT2.2, U_DOUT3.2, U_DOUT4.2,
        FB_AGND.2,
        C_ISO_L1.2, C_ISO_L2.2, U_ISO_RS485.GND1, U_ISO_DE.2, U_ISO_CAN.GND1
      ]
      power_flag: true
    }

    // ========================================================================
    // NETS — SHEET 2: MCU, MEMORY, DEBUG & ETHERNET
